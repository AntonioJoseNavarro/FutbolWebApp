// C:\DataFlexProjects\FutbolWebApp\AppSrc\ZoomJugador.wo
// Jugador
//

Use cWebView.pkg
Use cWebPanel.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use cWebHtmlBox.pkg
Use SelectEquipo.wo
// Vista a la que navega el boton "Ver posiciones" (Sprint 2 - Punto 4)
Use SelectPosicion.wo
// Funciones HTML (banderas, insignias, liga, entrenador)
Use Banderas.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use cjugadorDataDictionary.dd

Object oZoomJugador is a cWebView
    Set piColumnCount to 12
    Set psCaption to "Jugador"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtZoom
    Set pbShowCaption to False
    Set Verify_Save_Msg to 0
    Set piMaxWidth to 1024

    Object oliga_DD is a cligaDataDictionary
        // Sprint 3: el relate carga la liga DESPUES del equipo,
        // asi que tambien hay que redibujar el cromo cuando cambia la liga
        Procedure OnNewCurrentRecord RowID riOldRowId RowID riNewRowId
            Forward Send OnNewCurrentRecord riOldRowId riNewRowId
            Send ActualizarCabecera
        End_Procedure
    End_Object 

    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server to oliga_DD

        // Sprint 3: al cambiar de equipo (por ejemplo con la lupa)
        // se redibuja el cromo de la cabecera
        Procedure OnNewCurrentRecord RowID riOldRowId RowID riNewRowId
            Forward Send OnNewCurrentRecord riOldRowId riNewRowId
            Send ActualizarCabecera
        End_Procedure
    End_Object 

    Object ojugador_DD is a cjugadorDataDictionary
        Set DDO_Server to oequipo_DD

        // Sprint 3: al cargar otro jugador se redibuja el cromo de la cabecera
        Procedure OnNewCurrentRecord RowID riOldRowId RowID riNewRowId
            Forward Send OnNewCurrentRecord riOldRowId riNewRowId
            Send ActualizarCabecera
        End_Procedure
    End_Object 

    Set Main_DD to ojugador_DD
    Set Server  to ojugador_DD


    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        WebSetResponsive piColumnCount rmMobile to 4

        // Sprint 3: cabecera tipo "cromo" del jugador (se rellena en ActualizarCabecera)
        Object oCabecera is a cWebHtmlBox
            Set piColumnSpan to 0
            Set psHtml to ''
        End_Object

        Object ojugadorID is a cWebForm
            Entry_Item jugador.ID
            Set piColumnSpan to 2
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "ID"
        End_Object 

        Object ojugadorNombre is a cWebForm
            Entry_Item jugador.Nombre
            Set piColumnSpan to 10
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Nombre"
        End_Object 

        Object ojugadorApellido is a cWebForm
            Entry_Item jugador.Apellido
            Set piColumnSpan to 10
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Apellido"
        End_Object 

        Object ojugadorNacionalidad is a cWebForm
            Entry_Item jugador.Nacionalidad
            Set piColumnSpan to 8
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Nacionalidad"
        End_Object 

        Object oequipoID is a cWebForm
            Entry_Item equipo.ID
            Set piColumnSpan to 2
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "ID Equipo"
            Set pbPromptButton to True

            WebRegisterPath ntNavigateForward oSelectEquipo

            Procedure OnPrompt
                Send NavigatePath
            End_Procedure
        End_Object 

        Object oequipoNombre is a cWebForm
            Entry_Item equipo.Nombre
            Set piColumnSpan to 12
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Equipo"
            Set pbPromptButton to True

            WebRegisterPath ntNavigateForward oSelectEquipo

            Procedure OnPrompt
                Send NavigatePath
            End_Procedure
        End_Object 

        // Sprint 2 - Punto 4: navegacion Undefined (jugador -> posiciones).
        // jugador y posicion no tienen relacion directa (solo a traves de
        // jugadorposicion), por eso DataFlex no puede intercambiar datos
        // entre sus DD y el tipo de navegacion es nfUndefined.
        Object oVerPosicionesBtn is a cWebButton
            Set psCaption to "Ver posiciones"
            Set piColumnSpan to 4
            Set piColumnIndex to 0
            // Mismo estilo que el boton de ZoomLiga (application.css)
            Set psCSSClass to "BotonFutbol"

            WebRegisterPath ntNavigateForward oSelectPosicion

            Procedure OnClick
                Send NavigatePath
            End_Procedure
        End_Object
    End_Object 

    Object oActionGroup is a cWebMenuGroup

        Object oSaveBtn is a cWebMenuItem
            Set psCSSClass to "WebSaveMenuItem"
            Set psCaption to "Save"

            Procedure OnClick
                Send Request_Save
            End_Procedure

        End_Object 

        Object oEditBtn is a cWebMenuItem
            Set psCSSClass to "WebEditMenuItem"
            Set psCaption to "Edit"
            Procedure OnClick
                Send ChangeEditMode True
                Send SetActionButtons
            End_Procedure

        End_Object 

        Object oDeleteBtn is a cWebMenuItem
            Set psCSSClass to "WebDeleteMenuItem"
            Set psCaption to "Delete"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send Request_Delete
            End_Procedure

        End_Object 

        Object oCancelChangesBtn is a cWebMenuItem
            Set psCSSClass to "WebIcon_Refresh"
            Set psCaption to "Clear Changes"
            Set peActionDisplay to adMenu
            Procedure OnClick
                Send RefreshRecord
            End_Procedure

        End_Object 
    End_Object 

    // Sprint 3: construye el cromo de la cabecera con los datos actuales
    // de los DDO (jugador y, por el relate, su equipo y su liga).
    // Estructura: franja del club | nombre + datos con etiquetas | dorsal
    Procedure ActualizarCabecera
        String sNombre sApellido sNac sEquipo sLiga sPais sClase sHtml sID sMarca
        Integer iID iEquipoID

        Get Field_Current_Value of ojugador_DD Field jugador.ID           to iID
        Get Field_Current_Value of ojugador_DD Field jugador.Nombre       to sNombre
        Get Field_Current_Value of ojugador_DD Field jugador.Apellido     to sApellido
        Get Field_Current_Value of ojugador_DD Field jugador.Nacionalidad to sNac
        Get File_Field_Current_Value of ojugador_DD File_Field equipo.ID     to iEquipoID
        Get File_Field_Current_Value of ojugador_DD File_Field equipo.Nombre to sEquipo
        Get File_Field_Current_Value of ojugador_DD File_Field liga.Nombre   to sLiga
        Get File_Field_Current_Value of ojugador_DD File_Field liga.Pais     to sPais

        // Jugador nuevo (sin nombre todavia)
        If ((Trim(sNombre) = "") and (Trim(sApellido) = "")) Begin
            Move ('<div class="Cromo"><div class="CromoFranja otro"></div>' + ;
                  '<div class="CromoInfo"><div class="CromoNombre">Nuevo jugador</div>' + ;
                  '<div class="CromoAviso">Rellena sus datos y elige su equipo</div></div></div>') to sHtml
        End
        Else Begin
            Move (ClaseEquipo(sEquipo)) to sClase

            // Marca de agua: iniciales del club (o la inicial si no tiene colores)
            Move "" to sMarca
            If (Trim(sEquipo) <> "") Begin
                If (sClase = "otro") Begin
                    Move (Uppercase(Left(Trim(sEquipo), 1))) to sMarca
                End
                Else Begin
                    Move (Uppercase(sClase)) to sMarca
                End
            End

            Move iID to sID

            // Franja + nombre
            Move ('<div class="Cromo"><div class="CromoFranja ' + sClase + '"></div>' + ;
                  '<div class="CromoInfo">' + ;
                  '<div class="CromoNombre">' + htmlEncode(Trim(sNombre) + " " + Trim(sApellido)) + '</div>' + ;
                  '<div class="CromoDatos">') to sHtml

            // Datos con su etiqueta encima
            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Nacionalidad</div>' + BanderaHtml(sNac) + '</div>') to sHtml
            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Equipo</div>' + EquipoHtml(sEquipo) + '</div>') to sHtml
            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Liga</div>' + LigaHtml(sPais, sLiga) + '</div>') to sHtml
            If (iEquipoID <> 0) Begin
                Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Entrenador</div>' + EntrenadorHtml(iEquipoID) + '</div>') to sHtml
            End
            Move (sHtml + '</div></div>') to sHtml

            // Dorsal grande con las iniciales del club de fondo
            Move (sHtml + '<div class="CromoDorsal">' + ;
                  '<span class="CromoMarca">' + sMarca + '</span>' + ;
                  '<span class="CromoNumero"><small>#</small>' + sID + '</span>' + ;
                  '</div></div>') to sHtml
        End

        Send UpdateHTML of oCabecera sHtml
    End_Procedure

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord
        Handle hoDD

        Get Server to hoDD
        Get GetNavigateData to NavigateData
        Get HasRecord of hoDD to bHasRecord

        // let's hide all buttons and then Show the ones we want
        WebSet pbRender of oEditBtn to False
        WebSet pbRender of oSaveBtn to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn to False

        // El boton "Ver posiciones" solo se muestra si hay un jugador cargado
        WebSet pbRender of oVerPosicionesBtn to bHasRecord

        If (NavigateData.bReadOnly) Begin
            WebSet pbRender of oEditBtn to True
        End
        Else Begin
            WebSet pbRender of oSaveBtn to True
            WebSet pbRender of oCancelChangesBtn to True
            WebSet pbRender of oDeleteBtn to bHasRecord
        End
    End_Procedure

    Procedure OnViewSaved Handle hoServer Boolean bChanged
        // Close after save
        Send NavigateClose Self
    End_Procedure

    // this will close the view after a delete
    Procedure OnViewDeleted Handle hoDDO
        Send NavigateClose Self
    End_Procedure

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        Case Begin
            Case (NavigateData.eNavigateType = nfFromMain)
                // If from main, this is a propbably a main file Select to Zoom.
                Case Break

            Case (NavigateData.eNavigateType = nfFromParent)
                // If from parent, this is a constrained drill down.
                Case Break

            Case (NavigateData.eNavigateType = nfFromChild)
                // If from child, this is a probably a parent Zoom from a Zoom.
                Case Break

            Case Else // must be nfUndefined

        Case End

        Send SetActionButtons
        // Sprint 3: dibujar el cromo al abrir la ficha
        Send ActualizarCabecera

    End_Procedure

End_Object