// C:\DataFlexProjects\FutbolWebApp\AppSrc\ZoomPosicion.wo
// Posicion
//

Use cWebView.pkg
Use cWebPanel.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebForm.pkg
Use cWebHtmlBox.pkg
// Funciones HTML (icono de posicion)
Use Banderas.pkg

Use cposicionDataDictionary.dd

Object oZoomPosicion is a cWebView
    Set piColumnCount to 12
    Set psCaption to "Posición"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtZoom
    Set pbShowCaption to False
    Set Verify_Save_Msg to 0
    Set piMaxWidth to 1024

    Object oposicion_DD is a cposicionDataDictionary
        // Sprint 3: al cargar otra posicion se redibuja el cromo de la cabecera
        Procedure OnNewCurrentRecord RowID riOldRowId RowID riNewRowId
            Forward Send OnNewCurrentRecord riOldRowId riNewRowId
            Send ActualizarCabecera
        End_Procedure
    End_Object 

    Set Main_DD to oposicion_DD
    Set Server  to oposicion_DD


    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        WebSetResponsive piColumnCount rmMobile to 4

        // Sprint 3: cabecera tipo "cromo" de la posicion (se rellena en ActualizarCabecera)
        Object oCabecera is a cWebHtmlBox
            Set piColumnSpan to 0
            Set psHtml to ''
        End_Object

        Object oposicionID is a cWebForm
            Entry_Item posicion.ID
            Set piColumnSpan to 2
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "ID"
        End_Object 

        Object oposicionNombre is a cWebForm
            Entry_Item posicion.Nombre
            Set piColumnSpan to 8
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Nombre"
        End_Object 
    End_Object 

    Object oActionGroup is a cWebMenuGroup

        Object oSaveBtn is a cWebMenuItem
            Set psCSSClass to "WebSaveMenuItem"
            Set psCaption to "Save"

            Procedure OnClick
                Send Request_Save
            End_Procedure

        End_Object 

        Object oEditBtn is a cWebMenuItem
            Set psCSSClass to "WebEditMenuItem"
            Set psCaption to "Edit"
            Procedure OnClick
                Send ChangeEditMode True
                Send SetActionButtons
            End_Procedure

        End_Object 

        Object oDeleteBtn is a cWebMenuItem
            Set psCSSClass to "WebDeleteMenuItem"
            Set psCaption to "Delete"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send Request_Delete
            End_Procedure

        End_Object 

        Object oCancelChangesBtn is a cWebMenuItem
            Set psCSSClass to "WebIcon_Refresh"
            Set psCaption to "Clear Changes"
            Set peActionDisplay to adMenu
            Procedure OnClick
                Send RefreshRecord
            End_Procedure

        End_Object 
    End_Object 

    // Sprint 3: construye el cromo de la cabecera con los datos de la posicion.
    // Estructura: franja azul | nombre + tipo | icono grande en un circulo
    Procedure ActualizarCabecera
        String sPos sTipo sHtml

        Get Field_Current_Value of oposicion_DD Field posicion.Nombre to sPos
        Move (Trim(sPos)) to sPos

        // Posicion nueva (sin nombre todavia)
        If (sPos = "") Begin
            Move ('<div class="Cromo"><div class="CromoFranja otro"></div>' + ;
                  '<div class="CromoInfo"><div class="CromoNombre">Nueva posici&oacute;n</div>' + ;
                  '<div class="CromoAviso">Escribe el nombre de la posici&oacute;n</div></div></div>') to sHtml
        End
        Else Begin
            // Tipo: oficial (las 4 del terreno de juego) o personalizada
            Move "Personalizada" to sTipo
            If ((Left(sPos, 4) = "Port") or (Left(sPos, 4) = "Defe") or (Left(sPos, 4) = "Cent") or (Left(sPos, 4) = "Dela")) Begin
                Move "Oficial" to sTipo
            End

            Move ('<div class="Cromo"><div class="CromoFranja posicion"></div>' + ;
                  '<div class="CromoInfo">' + ;
                  '<div class="CromoNombre">' + htmlEncode(sPos) + '</div>' + ;
                  '<div class="CromoDatos">' + ;
                  '<div class="CromoDato"><div class="CromoEtiqueta">Tipo</div>' + sTipo + '</div>' + ;
                  '</div></div>' + ;
                  '<div class="CromoDorsal"><span class="CromoIconoPos">' + IconoPosicion(sPos) + '</span></div>' + ;
                  '</div>') to sHtml
        End

        Send UpdateHTML of oCabecera sHtml
    End_Procedure

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord
        Handle hoDD

        Get Server to hoDD
        Get GetNavigateData to NavigateData
        Get HasRecord of hoDD to bHasRecord

        // let's hide all buttons and then Show the ones we want
        WebSet pbRender of oEditBtn to False
        WebSet pbRender of oSaveBtn to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn to False

        If (NavigateData.bReadOnly) Begin
            WebSet pbRender of oEditBtn to True
        End
        Else Begin
            WebSet pbRender of oSaveBtn to True
            WebSet pbRender of oCancelChangesBtn to True
            WebSet pbRender of oDeleteBtn to bHasRecord
        End
    End_Procedure

    Procedure OnViewSaved Handle hoServer Boolean bChanged
        // Close after save
        Send NavigateClose Self
    End_Procedure

    // this will close the view after a delete
    Procedure OnViewDeleted Handle hoDDO
        Send NavigateClose Self
    End_Procedure

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        Case Begin
            Case (NavigateData.eNavigateType = nfFromMain)
                // If from main, this is a propbably a main file Select to Zoom.
                Case Break

            Case (NavigateData.eNavigateType = nfFromParent)
                // If from parent, this is a constrained drill down.
                Case Break

            Case (NavigateData.eNavigateType = nfFromChild)
                // If from child, this is a probably a parent Zoom from a Zoom.
                Case Break

            Case Else // must be nfUndefined

        Case End

        Send SetActionButtons
        // Sprint 3: dibujar el cromo al abrir la ficha
        Send ActualizarCabecera

    End_Procedure

End_Object