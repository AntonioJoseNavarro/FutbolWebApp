// C:\DataFlexProjects\FutbolWebApp\AppSrc\ZoomLiga.wo
// Liga
//

Use cWebView.pkg
Use cWebPanel.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebForm.pkg
Use cWebLabel.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use cWebHtmlBox.pkg
Use Banderas.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd

Object oZoomLiga is a cWebView
    Set piColumnCount to 12
    Set psCaption to "Liga"
    Set peWebViewStyle to wvsDrilldown
    Set peViewType to vtZoom
    Set pbShowCaption to False
    Set Verify_Save_Msg to 0
    Set piMaxWidth to 1024

    Object oliga_DD is a cligaDataDictionary
        // Sprint 3: al cargar otra liga se redibuja el cromo de la cabecera
        Procedure OnNewCurrentRecord RowID riOldRowId RowID riNewRowId
            Forward Send OnNewCurrentRecord riOldRowId riNewRowId
            Send ActualizarCabecera
        End_Procedure
    End_Object 

    // Sprint 2 - Punto 3.2: DD hijo (equipo) conectado al DD padre (liga).
    // Constrain_File hace que solo se vean los equipos de la liga cargada.
    // (Este DDO NO redibuja el cromo: cambia de registro al rellenar la lista)
    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server to oliga_DD
        Set Constrain_File to liga.File_Number
    End_Object 

    Set Main_DD to oliga_DD
    Set Server  to oliga_DD


    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        WebSetResponsive piColumnCount rmMobile to 4

        // Sprint 3: cabecera tipo "cromo" de la liga (se rellena en ActualizarCabecera)
        Object oCabecera is a cWebHtmlBox
            Set piColumnSpan to 0
            Set psHtml to ''
        End_Object

        Object oligaID is a cWebForm
            Entry_Item liga.ID
            Set piColumnSpan to 2
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "ID"
        End_Object 

        Object oligaNombre is a cWebForm
            Entry_Item liga.Nombre
            Set piColumnSpan to 12
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Nombre"
        End_Object 

        Object oligaPais is a cWebForm
            Entry_Item liga.Pais
            Set piColumnSpan to 8
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "País"
        End_Object 

        Object oligaEquipos is a cWebForm
            Entry_Item liga.Equipos
            Set piColumnSpan to 2
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Equipos"
        End_Object 

        Object oligaEquiposMax is a cWebForm
            Entry_Item liga.EquiposMax
            Set piColumnSpan to 3
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Máximo de equipos"
        End_Object 

        // Sprint 2 - Punto 3.2: en vez del boton, los equipos de esta liga
        Object oEquiposLabel is a cWebLabel
            Set psCaption to "Equipos de esta liga"
            Set piColumnSpan to 0
            // Estilo propio definido en application.css
            Set psCSSClass to "TituloSeccion"
        End_Object

        Object oEquiposList is a cWebList
            Set Server to oequipo_DD
            Set piColumnSpan to 0
            Set psCSSClass to "MobileList"
            Set pbShowHeader to False
            // Ordenada por la primera columna (ID) de menor a mayor
            Set piSortColumn to 0
            // Altura suficiente para ver varios equipos sin scroll
            Set piHeight to 300

            Object oequipoID is a cWebColumn
                Entry_Item equipo.ID
                Set psCaption to "ID"
                Set piWidth to 100
            End_Object

            // Nombre con insignia del equipo (columna calculada con HTML)
            Object oequipoNombre is a cWebColumn
                Set psCaption to "Equipo"
                Set piWidth to 900
                Set pbEnabled to False
                Set pbAllowHtml to True
                Set pbValueAsTooltip to False

                Procedure OnSetCalculatedValue String ByRef sValue
                    Move (EquipoHtml(equipo.Nombre)) to sValue
                End_Procedure
            End_Object
        End_Object
    End_Object 

    Object oActionGroup is a cWebMenuGroup

        Object oSaveBtn is a cWebMenuItem
            Set psCSSClass to "WebSaveMenuItem"
            Set psCaption to "Save"

            Procedure OnClick
                Send Request_Save
            End_Procedure

        End_Object 

        Object oEditBtn is a cWebMenuItem
            Set psCSSClass to "WebEditMenuItem"
            Set psCaption to "Edit"
            Procedure OnClick
                Send ChangeEditMode True
                Send SetActionButtons
            End_Procedure

        End_Object 

        Object oDeleteBtn is a cWebMenuItem
            Set psCSSClass to "WebDeleteMenuItem"
            Set psCaption to "Delete"
            Set peActionDisplay to adMenu

            Procedure OnClick
                Send Request_Delete
            End_Procedure

        End_Object 

        Object oCancelChangesBtn is a cWebMenuItem
            Set psCSSClass to "WebIcon_Refresh"
            Set psCaption to "Clear Changes"
            Set peActionDisplay to adMenu
            Procedure OnClick
                Send RefreshRecord
            End_Procedure

        End_Object 
    End_Object 

    // Sprint 3: construye el cromo de la cabecera con los datos de la liga.
    // Estructura: franja dorada | nombre + datos con etiquetas | bandera grande
    Procedure ActualizarCabecera
        String sLiga sPais sCod sHtml
        Integer iEquipos iMax

        Get Field_Current_Value of oliga_DD Field liga.Nombre     to sLiga
        Get Field_Current_Value of oliga_DD Field liga.Pais       to sPais
        Get Field_Current_Value of oliga_DD Field liga.Equipos    to iEquipos
        Get Field_Current_Value of oliga_DD Field liga.EquiposMax to iMax

        // Liga nueva (sin nombre todavia)
        If (Trim(sLiga) = "") Begin
            Move ('<div class="Cromo"><div class="CromoFranja otro"></div>' + ;
                  '<div class="CromoInfo"><div class="CromoNombre">Nueva liga</div>' + ;
                  '<div class="CromoAviso">Escribe su nombre, su pa&iacute;s y el m&aacute;ximo de equipos</div></div></div>') to sHtml
        End
        Else Begin
            // Franja dorada + nombre
            Move ('<div class="Cromo"><div class="CromoFranja oro"></div>' + ;
                  '<div class="CromoInfo">' + ;
                  '<div class="CromoNombre">' + htmlEncode(Trim(sLiga)) + '</div>' + ;
                  '<div class="CromoDatos">') to sHtml

            // Datos con su etiqueta encima
            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Pa&iacute;s</div>' + BanderaHtml(sPais) + '</div>') to sHtml
            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Plazas</div>' + PlazasHtml(iEquipos, iMax) + '</div>') to sHtml
            Move (sHtml + '</div></div>') to sHtml

            // Bandera grande del pais a la derecha (o un trofeo si no se reconoce)
            Move (CodigoBandera(sPais)) to sCod
            If (sCod <> "") Begin
                Move (sHtml + '<div class="CromoDorsal">' + ;
                      '<img class="CromoBanderaGrande" src="https://flagcdn.com/w160/' + sCod + '.png" alt="">' + ;
                      '</div></div>') to sHtml
            End
            Else Begin
                Move (sHtml + '<div class="CromoDorsal">' + ;
                      '<span class="CromoNumero CromoIcono">&#127942;</span>' + ;
                      '</div></div>') to sHtml
            End
        End

        Send UpdateHTML of oCabecera sHtml
    End_Procedure

    Procedure SetActionButtons
        tWebNavigateData NavigateData
        Boolean bHasRecord
        Handle hoDD

        Get Server to hoDD
        Get GetNavigateData to NavigateData
        Get HasRecord of hoDD to bHasRecord

        // let's hide all buttons and then Show the ones we want
        WebSet pbRender of oEditBtn to False
        WebSet pbRender of oSaveBtn to False
        WebSet pbRender of oCancelChangesBtn to False
        WebSet pbRender of oDeleteBtn to False

        If (NavigateData.bReadOnly) Begin
            WebSet pbRender of oEditBtn to True
        End
        Else Begin
            WebSet pbRender of oSaveBtn to True
            WebSet pbRender of oCancelChangesBtn to True
            WebSet pbRender of oDeleteBtn to bHasRecord
        End
    End_Procedure

    Procedure OnViewSaved Handle hoServer Boolean bChanged
        // Close after save
        Send NavigateClose Self
    End_Procedure

    // this will close the view after a delete
    Procedure OnViewDeleted Handle hoDDO
        Send NavigateClose Self
    End_Procedure

    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
        Case Begin
            Case (NavigateData.eNavigateType = nfFromMain)
                // If from main, this is a propbably a main file Select to Zoom.
                Case Break

            Case (NavigateData.eNavigateType = nfFromParent)
                // If from parent, this is a constrained drill down.
                Case Break

            Case (NavigateData.eNavigateType = nfFromChild)
                // If from child, this is a probably a parent Zoom from a Zoom.
                Case Break

            Case Else // must be nfUndefined

        Case End

        Send SetActionButtons
        // Sprint 3: dibujar el cromo al abrir la ficha
        Send ActualizarCabecera

    End_Procedure

End_Object