38493>>>        Case Begin
38493>>>            Case (NavigateData.eNavigateType = nfFromMain)
38495>>>                // If from main, this is a propbably a main file Select to Zoom.
38495>>>                Case Break
38496>>>
38496>>>            Case (NavigateData.eNavigateType = nfFromParent)
38499>>>                // If from parent, this is a constrained drill down.
38499>>>                Case Break
38500>>>
38500>>>            Case (NavigateData.eNavigateType = nfFromChild)
38503>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38503>>>                Case Break
38504>>>
38504>>>            Case Else // must be nfUndefined
38504>>>
38504>>>        Case End
38504>>>
38504>>>        Send SetActionButtons
38505>>>
38505>>>    End_Procedure
38506>>>
38506>>>End_Object
