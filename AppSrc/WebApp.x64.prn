38372>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38375>>>        Case Begin
38375>>>            Case (NavigateData.eNavigateType = nfFromMain)
38377>>>                // If from main, this is a propbably a main file Select to Zoom.
38377>>>                Case Break
38378>>>
38378>>>            Case (NavigateData.eNavigateType = nfFromParent)
38381>>>                // If from parent, this is a constrained drill down.
38381>>>                Case Break
38382>>>
38382>>>            Case (NavigateData.eNavigateType = nfFromChild)
38385>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38385>>>                Case Break
38386>>>
38386>>>            Case Else // must be nfUndefined
38386>>>
38386>>>        Case End
38386>>>
38386>>>        Send SetActionButtons
38387>>>        // Sprint 3: dibujar el cromo al abrir la ficha
38387>>>        Send ActualizarCabecera
38388>>>
38388>>>    End_Procedure
38389>>>
38389>>>End_Object
