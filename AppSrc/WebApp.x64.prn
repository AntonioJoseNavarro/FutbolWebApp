37547>>>>>// ---------------------------------------------------------------
37547>>>>>// Codigo de bandera (flagcdn.com) a partir de una nacionalidad o pais.
37547>>>>>// Devuelve "" si no se reconoce.
37547>>>>>// ---------------------------------------------------------------
37547>>>>>Function CodigoBandera Global String sNac Returns String
37549>>>>>    String sTexto sCod
37549>>>>>
37549>>>>>    Move (Trim(sNac)) to sTexto
37550>>>>>    Move "" to sCod
37551>>>>>
37551>>>>>    Case Begin
37551>>>>>        Case (Left(sTexto, 4) = "Espa")
37553>>>>>            Move "es" to sCod
37554>>>>>            Case Break
37555>>>>>        Case (Left(sTexto, 4) = "Alem")
37558>>>>>            Move "de" to sCod
37559>>>>>            Case Break
37560>>>>>        Case (Left(sTexto, 4) = "Arge")
37563>>>>>            Move "ar" to sCod
37564>>>>>            Case Break
37565>>>>>        Case (Left(sTexto, 4) = "Neer")
37568>>>>>            Move "nl" to sCod
37569>>>>>            Case Break
37570>>>>>        Case (Left(sTexto, 4) = "Ital")
37573>>>>>            Move "it" to sCod
37574>>>>>            Case Break
37575>>>>>        Case (Left(sTexto, 4) = "Belg")
37578>>>>>            Move "be" to sCod
37579>>>>>            Case Break
37580>>>>>        Case (Left(sTexto, 4) = "Bras")
37583>>>>>            Move "br" to sCod
37584>>>>>            Case Break
37585>>>>>        Case (Left(sTexto, 4) = "Fran")
37588>>>>>            Move "fr" to sCod
37589>>>>>            Case Break
37590>>>>>        Case (Left(sTexto, 4) = "Urug")
37593>>>>>            Move "uy" to sCod
37594>>>>>            Case Break
37595>>>>>        Case (Left(sTexto, 4) = "Ingl")
37598>>>>>            Move "gb-eng" to sCod
37599>>>>>            Case Break
37600>>>>>        Case (Left(sTexto, 4) = "Esco")
37603>>>>>            Move "gb-sct" to sCod
37604>>>>>            Case Break
37605>>>>>        Case (Left(sTexto, 4) = "Pola")
37608>>>>>            Move "pl" to sCod
37609>>>>>            Case Break
37610>>>>>        Case (Left(sTexto, 4) = "Eslo")
37613>>>>>            Move "si" to sCod
37614>>>>>            Case Break
37615>>>>>        Case (Left(sTexto, 4) = "Moza")
37618>>>>>            Move "mz" to sCod
37619>>>>>            Case Break
37620>>>>>        Case (Left(sTexto, 4) = "Port")
37623>>>>>            Move "pt" to sCod
37624>>>>>            Case Break
37625>>>>>        Case (Left(sTexto, 4) = "Noru")
37628>>>>>            Move "no" to sCod
37629>>>>>            Case Break
37630>>>>>        Case (Left(sTexto, 1) = "H")
37633>>>>>            // Hungaro
37633>>>>>            Move "hu" to sCod
37634>>>>>            Case Break
37635>>>>>        Case (Left(sTexto, 4) = "Colo")
37638>>>>>            Move "co" to sCod
37639>>>>>            Case Break
37640>>>>>        Case (Left(sTexto, 4) = "Egip")
37643>>>>>            Move "eg" to sCod
37644>>>>>            Case Break
37645>>>>>    Case End
37645>>>>>
37645>>>>>    Function_Return sCod
37646>>>>>End_Function
37647>>>>>
