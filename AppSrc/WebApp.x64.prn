38216>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38219>>>        Case Begin
38219>>>            Case (NavigateData.eNavigateType = nfFromMain)
38221>>>                // If from main, this is a propbably a main file Select to Zoom.
38221>>>                Case Break
38222>>>
38222>>>            Case (NavigateData.eNavigateType = nfFromParent)
38225>>>                // If from parent, this is a constrained drill down.
38225>>>                Case Break
38226>>>
38226>>>            Case (NavigateData.eNavigateType = nfFromChild)
38229>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38229>>>                Case Break
38230>>>
38230>>>            Case Else // must be nfUndefined
38230>>>
38230>>>        Case End
38230>>>
38230>>>        Send SetActionButtons
38231>>>
38231>>>    End_Procedure
38232>>>
38232>>>End_Object
