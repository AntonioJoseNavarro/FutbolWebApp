38426>>>        tWebNavigateData NavigateData
38426>>>        tWebNavigateData NavigateData
38426>>>        Boolean bHasRecord
38426>>>        Handle hoDD
38426>>>
38426>>>        Get Server to hoDD
38427>>>        Get GetNavigateData to NavigateData
38428>>>        Get HasRecord of hoDD to bHasRecord
38429>>>
38429>>>        // let's hide all buttons and then Show the ones we want
38429>>>        WebSet pbRender of oEditBtn to False
38430>>>        WebSet pbRender of oSaveBtn to False
38431>>>        WebSet pbRender of oCancelChangesBtn to False
38432>>>        WebSet pbRender of oDeleteBtn to False
38433>>>
38433>>>        If (NavigateData.bReadOnly) Begin
38435>>>            WebSet pbRender of oEditBtn to True
38436>>>        End
38436>>>>
38436>>>        Else Begin
38437>>>            WebSet pbRender of oSaveBtn to True
38438>>>            WebSet pbRender of oCancelChangesBtn to True
38439>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38440>>>        End
38440>>>>
38440>>>    End_Procedure
