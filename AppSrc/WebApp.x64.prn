38233>>>    // Sprint 3: construye el cromo de la cabecera con los datos de la liga.
38233>>>    // Estructura: franja dorada | nombre + datos con etiquetas | bandera grande
38233>>>    Procedure ActualizarCabecera
38236>>>        String sLiga sPais sCod sHtml
38236>>>        Integer iEquipos iMax
38236>>>
38236>>>        Get Field_Current_Value of oliga_DD Field liga.Nombre     to sLiga
38237>>>        Get Field_Current_Value of oliga_DD Field liga.Pais       to sPais
38238>>>        Get Field_Current_Value of oliga_DD Field liga.Equipos    to iEquipos
38239>>>        Get Field_Current_Value of oliga_DD Field liga.EquiposMax to iMax
38240>>>
38240>>>        // Liga nueva (sin nombre todavia)
38240>>>        If (Trim(sLiga) = "") Begin
38242>>>            Move ('<div class="Cromo"><div class="CromoFranja otro"></div>' + ;                  '<div class="CromoInfo"><div class="CromoNombre">Nueva liga</div>' + ;                  '<div class="CromoAviso">Escribe su nombre, su pa&iacute;s y el m&aacute;ximo de equipos</div></div></div>') to sHtml
38243>>>        End
38243>>>>
38243>>>        Else Begin
38244>>>            // Franja dorada + nombre
38244>>>            Move ('<div class="Cromo"><div class="CromoFranja oro"></div>' + ;                  '<div class="CromoInfo">' + ;                  '<div class="CromoNombre">' + htmlEncode(Trim(sLiga)) + '</div>' + ;                  '<div class="CromoDatos">') to sHtml
38245>>>
38245>>>            // Datos con su etiqueta encima
38245>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Pa&iacute;s</div>' + BanderaHtml(sPais) + '</div>') to sHtml
38246>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Plazas</div>' + PlazasHtml(iEquipos, iMax) + '</div>') to sHtml
38247>>>            Move (sHtml + '</div></div>') to sHtml
38248>>>
38248>>>            // Bandera grande del pais a la derecha (o un trofeo si no se reconoce)
38248>>>            Move (CodigoBandera(sPais)) to sCod
38249>>>            If (sCod <> "") Begin
38251>>>                Move (sHtml + '<div class="CromoDorsal">' + ;                      '<img class="CromoBanderaGrande" src="https://flagcdn.com/w160/' + sCod + '.png" alt="">' + ;                      '</div></div>') to sHtml
38252>>>            End
38252>>>>
38252>>>            Else Begin
38253>>>                Move (sHtml + '<div class="CromoDorsal">' + ;                      '<span class="CromoNumero CromoIcono">&#127942;</span>' + ;                      '</div></div>') to sHtml
38254>>>            End
38254>>>>
38254>>>        End
38254>>>>
38254>>>
38254>>>        Send UpdateHTML of oCabecera sHtml
38255>>>    End_Procedure
38256>>>
38256>>>    Procedure SetActionButtons
38259>>>        tWebNavigateData NavigateData
38259>>>        tWebNavigateData NavigateData
38259>>>        Boolean bHasRecord
38259>>>        Handle hoDD
38259>>>
38259>>>        Get Server to hoDD
38260>>>        Get GetNavigateData to NavigateData
38261>>>        Get HasRecord of hoDD to bHasRecord
38262>>>
38262>>>        // let's hide all buttons and then Show the ones we want
38262>>>        WebSet pbRender of oEditBtn to False
38263>>>        WebSet pbRender of oSaveBtn to False
38264>>>        WebSet pbRender of oCancelChangesBtn to False
38265>>>        WebSet pbRender of oDeleteBtn to False
38266>>>
38266>>>        If (NavigateData.bReadOnly) Begin
38268>>>            WebSet pbRender of oEditBtn to True
38269>>>        End
38269>>>>
38269>>>        Else Begin
38270>>>            WebSet pbRender of oSaveBtn to True
38271>>>            WebSet pbRender of oCancelChangesBtn to True
38272>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38273>>>        End
38273>>>>
38273>>>    End_Procedure
38274>>>
38274>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38277>>>        // Close after save
38277>>>        Send NavigateClose Self
38278>>>    End_Procedure
38279>>>
38279>>>    // this will close the view after a delete
38279>>>    Procedure OnViewDeleted Handle hoDDO
38282>>>        Send NavigateClose Self
38283>>>    End_Procedure
38284>>>
38284>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38287>>>        Case Begin
38287>>>            Case (NavigateData.eNavigateType = nfFromMain)
38289>>>                // If from main, this is a propbably a main file Select to Zoom.
38289>>>                Case Break
38290>>>
38290>>>            Case (NavigateData.eNavigateType = nfFromParent)
38293>>>                // If from parent, this is a constrained drill down.
38293>>>                Case Break
38294>>>
38294>>>            Case (NavigateData.eNavigateType = nfFromChild)
38297>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38297>>>                Case Break
38298>>>
38298>>>            Case Else // must be nfUndefined
38298>>>
38298>>>        Case End
38298>>>
38298>>>        Send SetActionButtons
38299>>>        // Sprint 3: dibujar el cromo al abrir la ficha
38299>>>        Send ActualizarCabecera
38300>>>
38300>>>    End_Procedure
38301>>>
38301>>>End_Object
