39197>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39200>>>        Case Begin
39200>>>            Case (NavigateData.eNavigateType = nfFromMain)
39202>>>                // If from main, this is a propbably a main file Select to Zoom.
39202>>>                Case Break
39203>>>
39203>>>            Case (NavigateData.eNavigateType = nfFromParent)
39206>>>                // If from parent, this is a constrained drill down.
39206>>>                Case Break
39207>>>
39207>>>            Case (NavigateData.eNavigateType = nfFromChild)
39210>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39210>>>                Case Break
39211>>>
39211>>>            Case Else // must be nfUndefined
39211>>>
39211>>>        Case End
39211>>>
39211>>>        Send SetActionButtons
39212>>>        // Sprint 3: dibujar el cromo al abrir la ficha
39212>>>        Send ActualizarCabecera
39213>>>
39213>>>    End_Procedure
39214>>>
39214>>>End_Object
