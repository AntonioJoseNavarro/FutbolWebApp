37487>>>    // Sprint 3: cuenta los registros de una tabla recorriendola por su indice 1.
37487>>>    // Recibe el numero de tabla (por ejemplo posicion.File_Number).
37487>>>    Function ContarRegistros Integer hTabla Returns Integer
37490>>>        Integer iNum
37490>>>
37490>>>        Move 0 to iNum
37491>>>        Clear hTabla
37492>>>        Vfind hTabla 1 GT
37494>>>        While (Found)
37498>>>            Increment iNum
37499>>>            Vfind hTabla 1 GT
37501>>>        Loop
37502>>>>
37502>>>
37502>>>        Function_Return iNum
37503>>>    End_Function
37504>>>
37504>>>    // Sprint 3: HTML de una tarjeta con su contador ("6 posiciones").
37504>>>    // Mantiene data-ServerOnClick para que la tarjeta siga navegando al pulsarla.
37504>>>    Function TileHtml String sEmoji String sTitulo Integer iNum String sSingular String sPlural Returns String
37507>>>        String sNum sTexto
37507>>>
37507>>>        Move iNum to sNum
37508>>>        If (iNum = 1) Begin
37510>>>            Move sSingular to sTexto
37511>>>        End
37511>>>>
37511>>>        Else Begin
37512>>>            Move sPlural to sTexto
37513>>>        End
37513>>>>
37513>>>
37513>>>        Function_Return ('<div class="WebCon_Sizer" data-ServerOnClick="openview">' + ;                         '<div class="Tile_Emoji">' + sEmoji + '</div>' + ;                         '<div class="Tile_Title">' + sTitulo + '</div>' + ;                         '<div class="Tile_Subtitle"><span class="Tile_Num">' + sNum + '</span> ' + sTexto + '</div>' + ;                         '</div>')
37514>>>    End_Function
37515>>>
37515>>>    // Sprint 3: recalcula los contadores y redibuja las 5 tarjetas
37515>>>    Procedure ActualizarContadores
37518>>>        Handle hTabla
37518>>>        Integer iNum
37518>>>        String sHtml
37518>>>
37518>>>        Move posicion.File_Number to hTabla
37519>>>        Get ContarRegistros hTabla to iNum
37520>>>        Get TileHtml "&#9917;" "Posiciones" iNum "posici&oacute;n" "posiciones" to sHtml
37521>>>        Send UpdateHTML of oTilePosicion sHtml
37522>>>
37522>>>        Move liga.File_Number to hTabla
37523>>>        Get ContarRegistros hTabla to iNum
37524>>>        Get TileHtml "&#127942;" "Ligas" iNum "liga" "ligas" to sHtml
37525>>>        Send UpdateHTML of oTileLiga sHtml
37526>>>
37526>>>        Move equipo.File_Number to hTabla
37527>>>        Get ContarRegistros hTabla to iNum
37528>>>        Get TileHtml "&#128085;" "Equipos" iNum "equipo" "equipos" to sHtml
37529>>>        Send UpdateHTML of oTileEquipo sHtml
37530>>>
37530>>>        Move entrenador.File_Number to hTabla
37531>>>        Get ContarRegistros hTabla to iNum
37532>>>        Get TileHtml "&#128203;" "Entrenadores" iNum "entrenador" "entrenadores" to sHtml
37533>>>        Send UpdateHTML of oTileEntrenador sHtml
37534>>>
37534>>>        Move jugador.File_Number to hTabla
37535>>>        Get ContarRegistros hTabla to iNum
37536>>>        Get TileHtml "&#128095;" "Jugadores" iNum "jugador" "jugadores" to sHtml
37537>>>        Send UpdateHTML of oTileJugador sHtml
37538>>>    End_Procedure
37539>>>    
37539>>>    // Se ejecuta cada vez que se muestra el Dashboard (tambien al volver a el)
37539>>>    Procedure OnBeforeShow
37542>>>        Send ActualizarContadores
37543>>>    End_Procedure
37544>>>
37544>>>End_Object
