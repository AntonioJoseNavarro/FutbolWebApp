39013>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
39016>>>        WebSet pbRender of oNewButton to True
39017>>>        WebSet pbRender of oDetailButton to True
39018>>>
39018>>>        Case Begin
39018>>>            Case (NavigateData.eNavigateType = nfFromParent)
39020>>>                // If from parent, this is a constrained drill down
39020>>>                // If Row select does main-zoom we don't need this
39020>>>                WebSet pbRender of oDetailButton to False
39021>>>                Case Break
39022>>>
39022>>>            Case (NavigateData.eNavigateType = nfFromChild)
39025>>>                // If from child, this is a probably a parent lookup from a Zoom
39025>>>                Case Break
39026>>>
39026>>>            Case (NavigateData.eNavigateType = nfFromMain)
39029>>>                // If from main, this is a probably a main-file lookup from a Zoom
39029>>>                WebSet pbRender of oDetailButton to False
39030>>>                Case Break
39031>>>
39031>>>            Case Else // must be nfUndefined
39031>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
39031>>>                // If Row select does main-zoom we don't need this
39031>>>                WebSet pbRender of oDetailButton to False
39032>>>
39032>>>        Case End
39032>>>
39032>>>    End_Procedure
