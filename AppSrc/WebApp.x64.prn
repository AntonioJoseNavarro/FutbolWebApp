37580>>>    Procedure SetActionButtons
37583>>>        tWebNavigateData NavigateData
37583>>>        tWebNavigateData NavigateData
37583>>>        Boolean bHasRecord
37583>>>        Handle hoDD
37583>>>
37583>>>        Get Server to hoDD
37584>>>        Get GetNavigateData to NavigateData
37585>>>        Get HasRecord of hoDD to bHasRecord
37586>>>
37586>>>        // let's hide all buttons and then Show the ones we want
37586>>>        WebSet pbRender of oEditBtn to False
37587>>>        WebSet pbRender of oSaveBtn to False
37588>>>        WebSet pbRender of oCancelChangesBtn to False
37589>>>        WebSet pbRender of oDeleteBtn to False
37590>>>
37590>>>        If (NavigateData.bReadOnly) Begin
37592>>>            WebSet pbRender of oEditBtn to True
37593>>>        End
37593>>>>
37593>>>        Else Begin
