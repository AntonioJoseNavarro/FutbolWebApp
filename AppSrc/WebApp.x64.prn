38457>>>            Case (NavigateData.eNavigateType = nfFromParent)
38460>>>                // If from parent, this is a constrained drill down.
38460>>>                Case Break
38461>>>
38461>>>            Case (NavigateData.eNavigateType = nfFromChild)
38464>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38464>>>                Case Break
38465>>>
38465>>>            Case Else // must be nfUndefined
38465>>>
38465>>>        Case End
38465>>>
38465>>>        Send SetActionButtons
38466>>>
