37605>>>>>// ---------------------------------------------------------------
37605>>>>>// Sprint 3: icono (entidad HTML) de una posicion.
37605>>>>>// Las posiciones no reconocidas llevan una bota.
37605>>>>>// ---------------------------------------------------------------
37605>>>>>Function IconoPosicion Global String sPos Returns String
37607>>>>>    String sTexto sIcono
37607>>>>>
37607>>>>>    Move (Trim(sPos)) to sTexto
37608>>>>>    // Icono por defecto (bota) para posiciones no reconocidas
37608>>>>>    Move "&#128095;" to sIcono
37609>>>>>
37609>>>>>    Case Begin
37609>>>>>        Case (Left(sTexto, 4) = "Port")
37611>>>>>            Move "&#129508;" to sIcono
37612>>>>>            Case Break
37613>>>>>        Case (Left(sTexto, 4) = "Defe")
37616>>>>>            Move "&#129521;" to sIcono
37617>>>>>            Case Break
37618>>>>>        Case (Left(sTexto, 4) = "Cent")
37621>>>>>            Move "&#127919;" to sIcono
37622>>>>>            Case Break
37623>>>>>        Case (Left(sTexto, 4) = "Dela")
37626>>>>>            Move "&#9917;" to sIcono
37627>>>>>            Case Break
37628>>>>>    Case End
37628>>>>>
37628>>>>>    Function_Return sIcono
37629>>>>>End_Function
37630>>>>>
37630>>>>>// ---------------------------------------------------------------
37630>>>>>// Icono de posicion + texto
37630>>>>>// ---------------------------------------------------------------
37630>>>>>Function PosicionHtml Global String sPos Returns String
37632>>>>>    Function_Return ('<span class="IconoPos">' + IconoPosicion(sPos) + '</span> ' + htmlEncode(Trim(sPos)))
37633>>>>>End_Function
37634>>>>>
37634>>>>>// ---------------------------------------------------------------
37634>>>>>// Sprint 3: clase CSS con los colores de cada club.
37634>>>>>// La usan la insignia (EquipoHtml) y la franja (JugadorHtml).
37634>>>>>// Devuelve "otro" para equipos sin colores definidos.
37634>>>>>// ---------------------------------------------------------------
37634>>>>>Function ClaseEquipo Global String sEquipo Returns String
37636>>>>>    String sTexto sClase
37636>>>>>
37636>>>>>    Move (Trim(sEquipo)) to sTexto
37637>>>>>    Move "otro" to sClase
37638>>>>>
37638>>>>>    Case Begin
37638>>>>>        Case (Left(sTexto, 4) = "Real")
37640>>>>>            Move "rm" to sClase
37641>>>>>            Case Break
37642>>>>>        Case (Left(sTexto, 4) = "FC B")
37645>>>>>            Move "fcb" to sClase
37646>>>>>            Case Break
37647>>>>>        Case (Left(sTexto, 3) = "Atl")
37650>>>>>            Move "atm" to sClase
37651>>>>>            Case Break
37652>>>>>        Case (Left(sTexto, 4) = "Manc")
37655>>>>>            Move "mci" to sClase
37656>>>>>            Case Break
37657>>>>>        Case (Left(sTexto, 4) = "Live")
37660>>>>>            Move "liv" to sClase
37661>>>>>            Case Break
37662>>>>>        Case (Left(sTexto, 4) = "Arse")
37665>>>>>            Move "ars" to sClase
37666>>>>>            Case Break
37667>>>>>    Case End
37667>>>>>
37667>>>>>    Function_Return sClase
37668>>>>>End_Function
37669>>>>>
37669>>>>>// ---------------------------------------------------------------
37669>>>>>// Insignia del equipo (iniciales con los colores del club) + texto.
37669>>>>>// Distintivo propio, NO el escudo oficial.
37669>>>>>// ---------------------------------------------------------------
37669>>>>>Function EquipoHtml Global String sEquipo Returns String
37671>>>>>    String sTexto sIni sClase
37671>>>>>
37671>>>>>    Move (Trim(sEquipo)) to sTexto
37672>>>>>
37672>>>>>    // Sprint 3: sin equipo asignado (por ejemplo, un entrenador libre)
37672>>>>>    If (sTexto = "") Begin
37674>>>>>        Function_Return '<span class="SinEquipo">Sin equipo</span>'
37675>>>>>    End
37675>>>>>>
37675>>>>>
37675>>>>>    Move (ClaseEquipo(sTexto)) to sClase
37676>>>>>
37676>>>>>    // Las iniciales coinciden con la clase (rm -> RM, fcb -> FCB...)
37676>>>>>    // Equipo nuevo sin colores definidos: insignia gris con la inicial
37676>>>>>    If (sClase = "otro") Begin
37678>>>>>        Move (Uppercase(Left(sTexto, 1))) to sIni
37679>>>>>    End
37679>>>>>>
37679>>>>>    Else Begin
37680>>>>>        Move (Uppercase(sClase)) to sIni
37681>>>>>    End
37681>>>>>>
37681>>>>>
37681>>>>>    Function_Return ('<span class="Insignia ' + sClase + '">' + sIni + '</span> <span class="EquipoNombre">' + htmlEncode(sTexto) + '</span>')
37682>>>>>End_Function
37683>>>>>
37683>>>>>// ---------------------------------------------------------------
37683>>>>>// Sprint 3: nombre completo de una persona (jugador o entrenador)
37683>>>>>// con una franja vertical de los colores de su equipo delante.
37683>>>>>// ---------------------------------------------------------------
37683>>>>>Function JugadorHtml Global String sNombre String sApellido String sEquipo Returns String
37685>>>>>    String sClase sCompleto
37685>>>>>
37685>>>>>    Move (ClaseEquipo(sEquipo)) to sClase
37686>>>>>    Move (Trim(sNombre) + " " + Trim(sApellido)) to sCompleto
37687>>>>>
37687>>>>>    Function_Return ('<span class="Franja ' + sClase + '"></span>' + htmlEncode(sCompleto))
37688>>>>>End_Function
37689>>>>>
37689>>>>>// ---------------------------------------------------------------
37689>>>>>// Sprint 3: entrenador de un equipo.
37689>>>>>// entrenador es HIJO de equipo, asi que el relate de los DD no lo trae:
37689>>>>>// se busca directamente (solo lectura) por el Index 3 (uqEntrenadorEquipo),
37689>>>>>// que es unico por EquipoID.
37689>>>>>// ---------------------------------------------------------------
37689>>>>>Function EntrenadorHtml Global Integer iEquipoID Returns String
37691>>>>>    String sNombre
37691>>>>>
37691>>>>>    If (iEquipoID = 0) Begin
37693>>>>>        Function_Return '<span class="SinEquipo">-</span>'
37694>>>>>    End
37694>>>>>>
37694>>>>>
37694>>>>>    Clear entrenador
37695>>>>>    Move iEquipoID to entrenador.EquipoID
37696>>>>>    Find EQ entrenador by Index.3
37697>>>>>>
37697>>>>>
37697>>>>>    If (Found) Begin
37699>>>>>        Move (Trim(entrenador.Nombre) + " " + Trim(entrenador.Apellido)) to sNombre
37700>>>>>        Function_Return ('<span class="EntrenadorChip">&#128203; ' + htmlEncode(sNombre) + '</span>')
37701>>>>>    End
37701>>>>>>
37701>>>>>
37701>>>>>    Function_Return '<span class="SinEquipo">Sin entrenador</span>'
37702>>>>>End_Function
37703>>>>>
37703>>>>>// ---------------------------------------------------------------
37703>>>>>// Sprint 3: plazas ocupadas de una liga ("3 / 20") con barra de ocupacion.
37703>>>>>// La barra se pinta de rojo cuando la liga esta llena.
37703>>>>>// ---------------------------------------------------------------
37703>>>>>Function PlazasHtml Global Integer iEquipos Integer iMax Returns String
37705>>>>>    Integer iPorc
37705>>>>>    String sEquipos sMax sPorc sClase
37705>>>>>
37705>>>>>    // Porcentaje de ocupacion (0-100)
37705>>>>>    If (iMax > 0) Begin
37707>>>>>        Move (iEquipos * 100 / iMax) to iPorc
37708>>>>>    End
37708>>>>>>
37708>>>>>    Else Begin
37709>>>>>        Move 0 to iPorc
37710>>>>>    End
37710>>>>>>
37710>>>>>    If (iPorc > 100) Begin
37712>>>>>        Move 100 to iPorc
37713>>>>>    End
37713>>>>>>
37713>>>>>
37713>>>>>    // Liga llena: clase extra para pintar la barra de rojo
37713>>>>>    Move "" to sClase
37714>>>>>    If ((iMax > 0) and (iEquipos >= iMax)) Begin
37716>>>>>        Move " Llena" to sClase
37717>>>>>    End
37717>>>>>>
37717>>>>>
37717>>>>>    Move iEquipos to sEquipos
37718>>>>>    Move iMax     to sMax
37719>>>>>    Move iPorc    to sPorc
37720>>>>>
37720>>>>>    Function_Return ('<span class="Plazas' + sClase + '">' + ;                     '<span class="PlazasTexto">' + sEquipos + ' / ' + sMax + '</span>' + ;                     '<span class="PlazasBarra"><span class="PlazasRelleno" style="width:' + sPorc + '%"></span></span>' + ;                     '</span>')
37721>>>>>End_Function
