38959>>>        Get HasRecord of hoDD to bHasRecord
38960>>>
38960>>>        // let's hide all buttons and then Show the ones we want
38960>>>        WebSet pbRender of oEditBtn to False
38961>>>        WebSet pbRender of oSaveBtn to False
38962>>>        WebSet pbRender of oCancelChangesBtn to False
38963>>>        WebSet pbRender of oDeleteBtn to False
38964>>>
38964>>>        If (NavigateData.bReadOnly) Begin
38966>>>            WebSet pbRender of oEditBtn to True
38967>>>        End
38967>>>>
38967>>>        Else Begin
38968>>>            WebSet pbRender of oSaveBtn to True
38969>>>            WebSet pbRender of oCancelChangesBtn to True
38970>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38971>>>        End
38971>>>>
