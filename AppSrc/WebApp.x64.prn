37535>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37538>>>        Case Begin
37538>>>            Case (NavigateData.eNavigateType = nfFromMain)
37540>>>                // If from main, this is a propbably a main file Select to Zoom.
37540>>>                Case Break
37541>>>
37541>>>            Case (NavigateData.eNavigateType = nfFromParent)
37544>>>                // If from parent, this is a constrained drill down.
37544>>>                Case Break
37545>>>
37545>>>            Case (NavigateData.eNavigateType = nfFromChild)
37548>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37548>>>                Case Break
37549>>>
37549>>>            Case Else // must be nfUndefined
37549>>>
37549>>>        Case End
37549>>>
37549>>>        Send SetActionButtons
37550>>>
37550>>>    End_Procedure
