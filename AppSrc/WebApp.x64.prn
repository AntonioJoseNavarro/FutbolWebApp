38104>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38107>>>        WebSet pbRender of oNewButton to True
38108>>>        WebSet pbRender of oDetailButton to True
38109>>>
38109>>>        Case Begin
38109>>>            Case (NavigateData.eNavigateType = nfFromParent)
38111>>>                // If from parent, this is a constrained drill down
38111>>>                // If Row select does main-zoom we don't need this
38111>>>                WebSet pbRender of oDetailButton to False
38112>>>                Case Break
38113>>>
38113>>>            Case (NavigateData.eNavigateType = nfFromChild)
38116>>>                // If from child, this is a probably a parent lookup from a Zoom
38116>>>                Case Break
38117>>>
38117>>>            Case (NavigateData.eNavigateType = nfFromMain)
38120>>>                // If from main, this is a probably a main-file lookup from a Zoom
38120>>>                WebSet pbRender of oDetailButton to False
38121>>>                Case Break
38122>>>
38122>>>            Case Else // must be nfUndefined
38122>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38122>>>                // If Row select does main-zoom we don't need this
38122>>>                WebSet pbRender of oDetailButton to False
38123>>>
38123>>>        Case End
38123>>>
38123>>>    End_Procedure
