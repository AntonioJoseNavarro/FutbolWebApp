37552>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37555>>>        Case Begin
37555>>>            Case (NavigateData.eNavigateType = nfFromMain)
37557>>>                // If from main, this is a propbably a main file Select to Zoom.
37557>>>                Case Break
37558>>>
37558>>>            Case (NavigateData.eNavigateType = nfFromParent)
37561>>>                // If from parent, this is a constrained drill down.
37561>>>                Case Break
37562>>>
37562>>>            Case (NavigateData.eNavigateType = nfFromChild)
37565>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37565>>>                Case Break
37566>>>
37566>>>            Case Else // must be nfUndefined
37566>>>
37566>>>        Case End
37566>>>
37566>>>        Send SetActionButtons
37567>>>
37567>>>    End_Procedure
