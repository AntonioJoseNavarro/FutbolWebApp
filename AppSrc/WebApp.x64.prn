39165>>>        tWebNavigateData NavigateData
39165>>>        tWebNavigateData NavigateData
39165>>>        Boolean bHasRecord
39165>>>        Handle hoDD
39165>>>
39165>>>        Get Server to hoDD
39166>>>        Get GetNavigateData to NavigateData
39167>>>        Get HasRecord of hoDD to bHasRecord
39168>>>
39168>>>        // let's hide all buttons and then Show the ones we want
39168>>>        WebSet pbRender of oEditBtn to False
39169>>>        WebSet pbRender of oSaveBtn to False
39170>>>        WebSet pbRender of oCancelChangesBtn to False
39171>>>        WebSet pbRender of oDeleteBtn to False
39172>>>
39172>>>        If (NavigateData.bReadOnly) Begin
39174>>>            WebSet pbRender of oEditBtn to True
39175>>>        End
39175>>>>
39175>>>        Else Begin
39176>>>            WebSet pbRender of oSaveBtn to True
39177>>>            WebSet pbRender of oCancelChangesBtn to True
39178>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39179>>>        End
39179>>>>
39179>>>    End_Procedure
