37610>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37613>>>        Case Begin
37613>>>            Case (NavigateData.eNavigateType = nfFromMain)
37615>>>                // If from main, this is a propbably a main file Select to Zoom.
37615>>>                Case Break
37616>>>
37616>>>            Case (NavigateData.eNavigateType = nfFromParent)
37619>>>                // If from parent, this is a constrained drill down.
37619>>>                Case Break
37620>>>
37620>>>            Case (NavigateData.eNavigateType = nfFromChild)
37623>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37623>>>                Case Break
37624>>>
37624>>>            Case Else // must be nfUndefined
37624>>>
37624>>>        Case End
37624>>>
37624>>>        Send SetActionButtons
37625>>>
37625>>>    End_Procedure
