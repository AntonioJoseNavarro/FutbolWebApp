39400>>>                // If from main, this is a probably a main-file lookup from a Zoom
39400>>>                WebSet pbRender of oDetailButton to False
39401>>>                Case Break
39402>>>
39402>>>            Case Else // must be nfUndefined
39402>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
39402>>>                // If Row select does main-zoom we don't need this
39402>>>                WebSet pbRender of oDetailButton to False
39403>>>
39403>>>        Case End
39403>>>
39403>>>    End_Procedure
