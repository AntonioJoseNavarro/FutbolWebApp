37868>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37868>>>                Case Break
37869>>>
37869>>>            Case Else // must be nfUndefined
37869>>>
37869>>>        Case End
37869>>>
37869>>>        Send SetActionButtons
