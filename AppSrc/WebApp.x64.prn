39203>>>                // If from child, this is a probably a parent Zoom from a Zoom.
39203>>>                Case Break
39204>>>
39204>>>            Case Else // must be nfUndefined
39204>>>
39204>>>        Case End
39204>>>
39204>>>        Send SetActionButtons
39205>>>
