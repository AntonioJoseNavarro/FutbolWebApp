38351>>>                WebSet pbRender of oDetailButton to False
38352>>>                Case Break
38353>>>
38353>>>            Case (NavigateData.eNavigateType = nfFromChild)
38356>>>                // If from child, this is a probably a parent lookup from a Zoom
38356>>>                Case Break
38357>>>
38357>>>            Case (NavigateData.eNavigateType = nfFromMain)
38360>>>                // If from main, this is a probably a main-file lookup from a Zoom
38360>>>                WebSet pbRender of oDetailButton to False
38361>>>                Case Break
38362>>>
38362>>>            Case Else // must be nfUndefined
38362>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38362>>>                // If Row select does main-zoom we don't need this
38362>>>                WebSet pbRender of oDetailButton to False
38363>>>
38363>>>        Case End
38363>>>
38363>>>    End_Procedure
