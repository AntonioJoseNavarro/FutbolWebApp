38450>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38453>>>        WebSet pbRender of oNewButton to True
38454>>>        WebSet pbRender of oDetailButton to True
38455>>>
38455>>>        Case Begin
38455>>>            Case (NavigateData.eNavigateType = nfFromParent)
38457>>>                // If from parent, this is a constrained drill down
38457>>>                // If Row select does main-zoom we don't need this
38457>>>                WebSet pbRender of oDetailButton to False
38458>>>                Case Break
38459>>>
38459>>>            Case (NavigateData.eNavigateType = nfFromChild)
38462>>>                // If from child, this is a probably a parent lookup from a Zoom
38462>>>                Case Break
38463>>>
38463>>>            Case (NavigateData.eNavigateType = nfFromMain)
38466>>>                // If from main, this is a probably a main-file lookup from a Zoom
38466>>>                WebSet pbRender of oDetailButton to False
38467>>>                Case Break
38468>>>
38468>>>            Case Else // must be nfUndefined
38468>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38468>>>                // If Row select does main-zoom we don't need this
38468>>>                WebSet pbRender of oDetailButton to False
38469>>>
38469>>>        Case End
38469>>>
38469>>>    End_Procedure
