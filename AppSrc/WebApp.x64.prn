39051>>>    // Sprint 3: construye el cromo de la cabecera con los datos actuales
39051>>>    // de los DDO (entrenador y, por el relate, su equipo y su liga).
39051>>>    // Estructura: franja del club | nombre + datos con etiquetas | icono de entrenador
39051>>>    Procedure ActualizarCabecera
39054>>>        String sNombre sApellido sNac sEquipo sLiga sPais sClase sHtml sMarca
39054>>>
39054>>>        Get Field_Current_Value of oentrenador_DD Field entrenador.Nombre       to sNombre
39055>>>        Get Field_Current_Value of oentrenador_DD Field entrenador.Apellido     to sApellido
39056>>>        Get Field_Current_Value of oentrenador_DD Field entrenador.Nacionalidad to sNac
39057>>>        Get File_Field_Current_Value of oentrenador_DD File_Field equipo.Nombre to sEquipo
39058>>>        Get File_Field_Current_Value of oentrenador_DD File_Field liga.Nombre   to sLiga
39059>>>        Get File_Field_Current_Value of oentrenador_DD File_Field liga.Pais     to sPais
39060>>>
39060>>>        // Entrenador nuevo (sin nombre todavia)
39060>>>        If ((Trim(sNombre) = "") and (Trim(sApellido) = "")) Begin
39062>>>            Move ('<div class="Cromo"><div class="CromoFranja otro"></div>' + ;                  '<div class="CromoInfo"><div class="CromoNombre">Nuevo entrenador</div>' + ;                  '<div class="CromoAviso">Rellena sus datos y elige su equipo</div></div></div>') to sHtml
39063>>>        End
39063>>>>
39063>>>        Else Begin
39064>>>            Move (ClaseEquipo(sEquipo)) to sClase
39065>>>
39065>>>            // Marca de agua: iniciales del club (o la inicial si no tiene colores)
39065>>>            Move "" to sMarca
39066>>>            If (Trim(sEquipo) <> "") Begin
39068>>>                If (sClase = "otro") Begin
39070>>>                    Move (Uppercase(Left(Trim(sEquipo), 1))) to sMarca
39071>>>                End
39071>>>>
39071>>>                Else Begin
39072>>>                    Move (Uppercase(sClase)) to sMarca
39073>>>                End
39073>>>>
39073>>>            End
39073>>>>
39073>>>
39073>>>            // Franja + nombre
39073>>>            Move ('<div class="Cromo"><div class="CromoFranja ' + sClase + '"></div>' + ;                  '<div class="CromoInfo">' + ;                  '<div class="CromoNombre">' + htmlEncode(Trim(sNombre) + " " + Trim(sApellido)) + '</div>' + ;                  '<div class="CromoDatos">') to sHtml
39074>>>
39074>>>            // Datos con su etiqueta encima
39074>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Nacionalidad</div>' + BanderaHtml(sNac) + '</div>') to sHtml
39075>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Equipo</div>' + EquipoHtml(sEquipo) + '</div>') to sHtml
39076>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Liga</div>' + LigaHtml(sPais, sLiga) + '</div>') to sHtml
39077>>>            Move (sHtml + '</div></div>') to sHtml
39078>>>
39078>>>            // Icono de entrenador grande con las iniciales del club de fondo
39078>>>            Move (sHtml + '<div class="CromoDorsal">' + ;                  '<span class="CromoMarca">' + sMarca + '</span>' + ;                  '<span class="CromoNumero CromoIcono">&#128203;</span>' + ;                  '</div></div>') to sHtml
39079>>>        End
39079>>>>
39079>>>
39079>>>        Send UpdateHTML of oCabecera sHtml
39080>>>    End_Procedure
39081>>>
39081>>>    Procedure SetActionButtons
39084>>>        tWebNavigateData NavigateData
39084>>>        tWebNavigateData NavigateData
39084>>>        Boolean bHasRecord
39084>>>        Handle hoDD
39084>>>
39084>>>        Get Server to hoDD
39085>>>        Get GetNavigateData to NavigateData
39086>>>        Get HasRecord of hoDD to bHasRecord
39087>>>
39087>>>        // let's hide all buttons and then Show the ones we want
39087>>>        WebSet pbRender of oEditBtn to False
39088>>>        WebSet pbRender of oSaveBtn to False
39089>>>        WebSet pbRender of oCancelChangesBtn to False
39090>>>        WebSet pbRender of oDeleteBtn to False
39091>>>
39091>>>        If (NavigateData.bReadOnly) Begin
39093>>>            WebSet pbRender of oEditBtn to True
39094>>>        End
39094>>>>
39094>>>        Else Begin
39095>>>            WebSet pbRender of oSaveBtn to True
39096>>>            WebSet pbRender of oCancelChangesBtn to True
39097>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39098>>>        End
39098>>>>
39098>>>    End_Procedure
