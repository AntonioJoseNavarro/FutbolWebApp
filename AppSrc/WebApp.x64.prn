38460>>>    Procedure SetActionButtons
38463>>>        tWebNavigateData NavigateData
38463>>>        tWebNavigateData NavigateData
38463>>>        Boolean bHasRecord
38463>>>        Handle hoDD
38463>>>
38463>>>        Get Server to hoDD
38464>>>        Get GetNavigateData to NavigateData
38465>>>        Get HasRecord of hoDD to bHasRecord
38466>>>
38466>>>        // let's hide all buttons and then Show the ones we want
38466>>>        WebSet pbRender of oEditBtn to False
38467>>>        WebSet pbRender of oSaveBtn to False
38468>>>        WebSet pbRender of oCancelChangesBtn to False
38469>>>        WebSet pbRender of oDeleteBtn to False
38470>>>
38470>>>        If (NavigateData.bReadOnly) Begin
38472>>>            WebSet pbRender of oEditBtn to True
38473>>>        End
38473>>>>
38473>>>        Else Begin
38474>>>            WebSet pbRender of oSaveBtn to True
38475>>>            WebSet pbRender of oCancelChangesBtn to True
38476>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38477>>>        End
38477>>>>
38477>>>    End_Procedure
