38129>>>    Procedure SetActionButtons
38132>>>        tWebNavigateData NavigateData
38132>>>        tWebNavigateData NavigateData
38132>>>        Boolean bHasRecord
38132>>>        Handle hoDD
38132>>>
38132>>>        Get Server to hoDD
38133>>>        Get GetNavigateData to NavigateData
38134>>>        Get HasRecord of hoDD to bHasRecord
38135>>>
38135>>>        // let's hide all buttons and then Show the ones we want
38135>>>        WebSet pbRender of oEditBtn to False
38136>>>        WebSet pbRender of oSaveBtn to False
38137>>>        WebSet pbRender of oCancelChangesBtn to False
38138>>>        WebSet pbRender of oDeleteBtn to False
38139>>>
38139>>>        If (NavigateData.bReadOnly) Begin
38141>>>            WebSet pbRender of oEditBtn to True
38142>>>        End
38142>>>>
38142>>>        Else Begin
38143>>>            WebSet pbRender of oSaveBtn to True
38144>>>            WebSet pbRender of oCancelChangesBtn to True
38145>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38146>>>        End
38146>>>>
38146>>>    End_Procedure
38147>>>
38147>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38150>>>        // Close after save
38150>>>        Send NavigateClose Self
38151>>>    End_Procedure
38152>>>
38152>>>    // this will close the view after a delete
38152>>>    Procedure OnViewDeleted Handle hoDDO
38155>>>        Send NavigateClose Self
38156>>>    End_Procedure
38157>>>
38157>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38160>>>        Case Begin
38160>>>            Case (NavigateData.eNavigateType = nfFromMain)
38162>>>                // If from main, this is a propbably a main file Select to Zoom.
38162>>>                Case Break
38163>>>
38163>>>            Case (NavigateData.eNavigateType = nfFromParent)
38166>>>                // If from parent, this is a constrained drill down.
38166>>>                Case Break
38167>>>
38167>>>            Case (NavigateData.eNavigateType = nfFromChild)
38170>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38170>>>                Case Break
38171>>>
38171>>>            Case Else // must be nfUndefined
38171>>>
38171>>>        Case End
38171>>>
38171>>>        Send SetActionButtons
38172>>>
38172>>>    End_Procedure
38173>>>
38173>>>End_Object
