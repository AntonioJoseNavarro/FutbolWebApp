38657>>>        Else Begin
38658>>>            WebSet pbRender of oSaveBtn to True
38659>>>            WebSet pbRender of oCancelChangesBtn to True
38660>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38661>>>        End
