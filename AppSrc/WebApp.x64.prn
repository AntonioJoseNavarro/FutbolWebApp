37625>>>>>// Funciones que devuelven HTML con iconos para las listas.
37625>>>>>// Se compara por las primeras letras (sin tildes) para que funcione
37625>>>>>// igual sea cual sea la codificacion del archivo.
37625>>>>>
37625>>>>>// ---------------------------------------------------------------
37625>>>>>// Bandera + texto (nacionalidades y paises).
37625>>>>>// Imagenes de banderas de flagcdn.com
37625>>>>>// ---------------------------------------------------------------
37625>>>>>Function BanderaHtml Global String sNac Returns String
37627>>>>>    String sTexto sCod
37627>>>>>
37627>>>>>    Move (Trim(sNac)) to sTexto
37628>>>>>    Move "" to sCod
37629>>>>>
37629>>>>>    Case Begin
37629>>>>>        Case (Left(sTexto, 4) = "Espa")
37631>>>>>            Move "es" to sCod
37632>>>>>            Case Break
37633>>>>>        Case (Left(sTexto, 4) = "Alem")
37636>>>>>            Move "de" to sCod
37637>>>>>            Case Break
37638>>>>>        Case (Left(sTexto, 4) = "Arge")
37641>>>>>            Move "ar" to sCod
37642>>>>>            Case Break
37643>>>>>        Case (Left(sTexto, 4) = "Neer")
37646>>>>>            Move "nl" to sCod
37647>>>>>            Case Break
37648>>>>>        Case (Left(sTexto, 4) = "Ital")
37651>>>>>            Move "it" to sCod
37652>>>>>            Case Break
37653>>>>>        Case (Left(sTexto, 4) = "Belg")
37656>>>>>            Move "be" to sCod
37657>>>>>            Case Break
37658>>>>>        Case (Left(sTexto, 4) = "Bras")
37661>>>>>            Move "br" to sCod
37662>>>>>            Case Break
37663>>>>>        Case (Left(sTexto, 4) = "Fran")
37666>>>>>            Move "fr" to sCod
37667>>>>>            Case Break
37668>>>>>        Case (Left(sTexto, 4) = "Urug")
37671>>>>>            Move "uy" to sCod
37672>>>>>            Case Break
37673>>>>>        Case (Left(sTexto, 4) = "Ingl")
37676>>>>>            Move "gb-eng" to sCod
37677>>>>>            Case Break
37678>>>>>        Case (Left(sTexto, 4) = "Esco")
37681>>>>>            Move "gb-sct" to sCod
37682>>>>>            Case Break
37683>>>>>        Case (Left(sTexto, 4) = "Pola")
37686>>>>>            Move "pl" to sCod
37687>>>>>            Case Break
37688>>>>>        Case (Left(sTexto, 4) = "Eslo")
37691>>>>>            Move "si" to sCod
37692>>>>>            Case Break
37693>>>>>        Case (Left(sTexto, 4) = "Moza")
37696>>>>>            Move "mz" to sCod
37697>>>>>            Case Break
37698>>>>>        Case (Left(sTexto, 4) = "Port")
37701>>>>>            Move "pt" to sCod
37702>>>>>            Case Break
37703>>>>>        Case (Left(sTexto, 4) = "Noru")
37706>>>>>            Move "no" to sCod
37707>>>>>            Case Break
37708>>>>>        Case (Left(sTexto, 1) = "H")
37711>>>>>            // Hungaro
37711>>>>>            Move "hu" to sCod
37712>>>>>            Case Break
37713>>>>>        Case (Left(sTexto, 4) = "Colo")
37716>>>>>            Move "co" to sCod
37717>>>>>            Case Break
37718>>>>>        Case (Left(sTexto, 4) = "Egip")
37721>>>>>            Move "eg" to sCod
37722>>>>>            Case Break
37723>>>>>    Case End
37723>>>>>
37723>>>>>    If (sCod = "") Begin
37725>>>>>        Function_Return (htmlEncode(sTexto))
37726>>>>>    End
37726>>>>>>
37726>>>>>
37726>>>>>    Function_Return ('<img class="Bandera" src="https://flagcdn.com/w40/' + sCod + '.png" alt=""> ' + htmlEncode(sTexto))
37727>>>>>End_Function
37728>>>>>
37728>>>>>// ---------------------------------------------------------------
37728>>>>>// Icono de posicion + texto
37728>>>>>// ---------------------------------------------------------------
37728>>>>>Function PosicionHtml Global String sPos Returns String
37730>>>>>    String sTexto sIcono
37730>>>>>
37730>>>>>    Move (Trim(sPos)) to sTexto
37731>>>>>    Move "" to sIcono
37732>>>>>
37732>>>>>    Case Begin
37732>>>>>        Case (Left(sTexto, 4) = "Port")
37734>>>>>            Move "&#129508;" to sIcono
37735>>>>>            Case Break
37736>>>>>        Case (Left(sTexto, 4) = "Defe")
37739>>>>>            Move "&#129521;" to sIcono
37740>>>>>            Case Break
37741>>>>>        Case (Left(sTexto, 4) = "Cent")
37744>>>>>            Move "&#127919;" to sIcono
37745>>>>>            Case Break
37746>>>>>        Case (Left(sTexto, 4) = "Dela")
37749>>>>>            Move "&#9917;" to sIcono
37750>>>>>            Case Break
37751>>>>>    Case End
37751>>>>>
37751>>>>>    If (sIcono = "") Begin
37753>>>>>        Function_Return (htmlEncode(sTexto))
37754>>>>>    End
37754>>>>>>
37754>>>>>
37754>>>>>    Function_Return ('<span class="IconoPos">' + sIcono + '</span> ' + htmlEncode(sTexto))
37755>>>>>End_Function
37756>>>>>
37756>>>>>// ---------------------------------------------------------------
37756>>>>>// Insignia del equipo (iniciales con los colores del club) + texto.
37756>>>>>// Distintivo propio, NO el escudo oficial.
37756>>>>>// ---------------------------------------------------------------
37756>>>>>Function EquipoHtml Global String sEquipo Returns String
37758>>>>>    String sTexto sIni sClase
37758>>>>>
37758>>>>>    Move (Trim(sEquipo)) to sTexto
37759>>>>>    Move "" to sIni
37760>>>>>    Move "" to sClase
37761>>>>>
37761>>>>>    Case Begin
37761>>>>>        Case (Left(sTexto, 4) = "Real")
37763>>>>>            Move "RM" to sIni
37764>>>>>            Move "rm" to sClase
37765>>>>>            Case Break
37766>>>>>        Case (Left(sTexto, 4) = "FC B")
37769>>>>>            Move "FCB" to sIni
37770>>>>>            Move "fcb" to sClase
37771>>>>>            Case Break
37772>>>>>        Case (Left(sTexto, 3) = "Atl")
37775>>>>>            Move "ATM" to sIni
37776>>>>>            Move "atm" to sClase
37777>>>>>            Case Break
37778>>>>>        Case (Left(sTexto, 4) = "Manc")
37781>>>>>            Move "MCI" to sIni
37782>>>>>            Move "mci" to sClase
37783>>>>>            Case Break
37784>>>>>        Case (Left(sTexto, 4) = "Live")
37787>>>>>            Move "LIV" to sIni
37788>>>>>            Move "liv" to sClase
37789>>>>>            Case Break
37790>>>>>        Case (Left(sTexto, 4) = "Arse")
37793>>>>>            Move "ARS" to sIni
37794>>>>>            Move "ars" to sClase
37795>>>>>            Case Break
37796>>>>>    Case End
37796>>>>>
37796>>>>>    // Equipo nuevo sin insignia definida: insignia gris con la inicial
37796>>>>>    If (sIni = "") Begin
37798>>>>>        Move (Uppercase(Left(sTexto, 1))) to sIni
37799>>>>>        Move "otro" to sClase
37800>>>>>    End
37800>>>>>>
37800>>>>>
37800>>>>>    Function_Return ('<span class="Insignia ' + sClase + '">' + sIni + '</span> ' + htmlEncode(sTexto))
37801>>>>>End_Function
