38493>>>                // If from main, this is a propbably a main file Select to Zoom.
38493>>>                Case Break
38494>>>
38494>>>            Case (NavigateData.eNavigateType = nfFromParent)
38497>>>                // If from parent, this is a constrained drill down.
38497>>>                Case Break
38498>>>
38498>>>            Case (NavigateData.eNavigateType = nfFromChild)
38501>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38501>>>                Case Break
38502>>>
38502>>>            Case Else // must be nfUndefined
38502>>>
38502>>>        Case End
38502>>>
38502>>>        Send SetActionButtons
38503>>>
38503>>>    End_Procedure
38504>>>
38504>>>End_Object
