38513>>>        tWebNavigateData NavigateData
38513>>>        tWebNavigateData NavigateData
38513>>>        Boolean bHasRecord
38513>>>        Handle hoDD
38513>>>
38513>>>        Get Server to hoDD
38514>>>        Get GetNavigateData to NavigateData
38515>>>        Get HasRecord of hoDD to bHasRecord
38516>>>
38516>>>        // let's hide all buttons and then Show the ones we want
38516>>>        WebSet pbRender of oEditBtn to False
38517>>>        WebSet pbRender of oSaveBtn to False
38518>>>        WebSet pbRender of oCancelChangesBtn to False
38519>>>        WebSet pbRender of oDeleteBtn to False
38520>>>
38520>>>        If (NavigateData.bReadOnly) Begin
38522>>>            WebSet pbRender of oEditBtn to True
38523>>>        End
38523>>>>
38523>>>        Else Begin
38524>>>            WebSet pbRender of oSaveBtn to True
38525>>>            WebSet pbRender of oCancelChangesBtn to True
38526>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38527>>>        End
38527>>>>
38527>>>    End_Procedure
