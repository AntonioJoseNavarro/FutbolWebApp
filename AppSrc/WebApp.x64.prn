37983>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37986>>>        WebSet pbRender of oNewButton to True
37987>>>        WebSet pbRender of oDetailButton to True
37988>>>
37988>>>        Case Begin
37988>>>            Case (NavigateData.eNavigateType = nfFromParent)
37990>>>                // If from parent, this is a constrained drill down
37990>>>                // If Row select does main-zoom we don't need this
37990>>>                WebSet pbRender of oDetailButton to False
37991>>>                Case Break
37992>>>
37992>>>            Case (NavigateData.eNavigateType = nfFromChild)
37995>>>                // If from child, this is a probably a parent lookup from a Zoom
37995>>>                Case Break
37996>>>
37996>>>            Case (NavigateData.eNavigateType = nfFromMain)
37999>>>                // If from main, this is a probably a main-file lookup from a Zoom
37999>>>                WebSet pbRender of oDetailButton to False
38000>>>                Case Break
38001>>>
38001>>>            Case Else // must be nfUndefined
38001>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38001>>>                // If Row select does main-zoom we don't need this
38001>>>                WebSet pbRender of oDetailButton to False
38002>>>
38002>>>        Case End
38002>>>
38002>>>    End_Procedure
38003>>>
