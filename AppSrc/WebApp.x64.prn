38188>>>    Procedure SetActionButtons
38191>>>        tWebNavigateData NavigateData
38191>>>        tWebNavigateData NavigateData
38191>>>        Boolean bHasRecord
38191>>>        Handle hoDD
38191>>>
38191>>>        Get Server to hoDD
38192>>>        Get GetNavigateData to NavigateData
38193>>>        Get HasRecord of hoDD to bHasRecord
38194>>>
38194>>>        // let's hide all buttons and then Show the ones we want
38194>>>        WebSet pbRender of oEditBtn to False
38195>>>        WebSet pbRender of oSaveBtn to False
38196>>>        WebSet pbRender of oCancelChangesBtn to False
38197>>>        WebSet pbRender of oDeleteBtn to False
38198>>>
38198>>>        If (NavigateData.bReadOnly) Begin
38200>>>            WebSet pbRender of oEditBtn to True
38201>>>        End
38201>>>>
38201>>>        Else Begin
38202>>>            WebSet pbRender of oSaveBtn to True
38203>>>            WebSet pbRender of oCancelChangesBtn to True
38204>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38205>>>        End
38205>>>>
38205>>>    End_Procedure
