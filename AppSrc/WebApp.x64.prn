38615>>>    // Sprint 3: construye el cromo de la cabecera con los datos actuales
38615>>>    // de los DDO (equipo y, por el relate, su liga).
38615>>>    // Estructura: franja del club | nombre + datos con etiquetas | insignia grande
38615>>>    Procedure ActualizarCabecera
38618>>>        String sEquipo sLiga sPais sClase sIni sHtml
38618>>>        Integer iEquipoID
38618>>>
38618>>>        Get Field_Current_Value of oequipo_DD Field equipo.ID     to iEquipoID
38619>>>        Get Field_Current_Value of oequipo_DD Field equipo.Nombre to sEquipo
38620>>>        Get File_Field_Current_Value of oequipo_DD File_Field liga.Nombre to sLiga
38621>>>        Get File_Field_Current_Value of oequipo_DD File_Field liga.Pais   to sPais
38622>>>
38622>>>        // Equipo nuevo (sin nombre todavia)
38622>>>        If (Trim(sEquipo) = "") Begin
38624>>>            Move ('<div class="Cromo"><div class="CromoFranja otro"></div>' + ;                  '<div class="CromoInfo"><div class="CromoNombre">Nuevo equipo</div>' + ;                  '<div class="CromoAviso">Escribe su nombre y elige su liga</div></div></div>') to sHtml
38625>>>        End
38625>>>>
38625>>>        Else Begin
38626>>>            Move (ClaseEquipo(sEquipo)) to sClase
38627>>>
38627>>>            // Iniciales de la insignia grande (o la inicial si no tiene colores)
38627>>>            If (sClase = "otro") Begin
38629>>>                Move (Uppercase(Left(Trim(sEquipo), 1))) to sIni
38630>>>            End
38630>>>>
38630>>>            Else Begin
38631>>>                Move (Uppercase(sClase)) to sIni
38632>>>            End
38632>>>>
38632>>>
38632>>>            // Franja + nombre
38632>>>            Move ('<div class="Cromo"><div class="CromoFranja ' + sClase + '"></div>' + ;                  '<div class="CromoInfo">' + ;                  '<div class="CromoNombre">' + htmlEncode(Trim(sEquipo)) + '</div>' + ;                  '<div class="CromoDatos">') to sHtml
38633>>>
38633>>>            // Datos con su etiqueta encima
38633>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Liga</div>' + LigaHtml(sPais, sLiga) + '</div>') to sHtml
38634>>>            If (Trim(sPais) <> "") Begin
38636>>>                Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Pa&iacute;s</div>' + BanderaHtml(sPais) + '</div>') to sHtml
38637>>>            End
38637>>>>
38637>>>            If (iEquipoID <> 0) Begin
38639>>>                Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Entrenador</div>' + EntrenadorHtml(iEquipoID) + '</div>') to sHtml
38640>>>            End
38640>>>>
38640>>>            Move (sHtml + '</div></div>') to sHtml
38641>>>
38641>>>            // Insignia del club en grande a la derecha
38641>>>            Move (sHtml + '<div class="CromoDorsal">' + ;                  '<span class="Insignia ' + sClase + ' CromoInsigniaGrande">' + sIni + '</span>' + ;                  '</div></div>') to sHtml
38642>>>        End
38642>>>>
38642>>>
38642>>>        Send UpdateHTML of oCabecera sHtml
38643>>>    End_Procedure
38644>>>
