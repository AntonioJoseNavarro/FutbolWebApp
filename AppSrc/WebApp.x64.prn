37531>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37531>>>                Case Break
37532>>>
37532>>>            Case Else // must be nfUndefined
37532>>>
37532>>>        Case End
37532>>>
37532>>>        Send SetActionButtons
