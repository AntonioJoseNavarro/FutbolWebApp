38582>>>    Procedure SetActionButtons
38585>>>        tWebNavigateData NavigateData
38585>>>        tWebNavigateData NavigateData
38585>>>        Boolean bHasRecord
38585>>>        Handle hoDD
38585>>>
38585>>>        Get Server to hoDD
38586>>>        Get GetNavigateData to NavigateData
38587>>>        Get HasRecord of hoDD to bHasRecord
38588>>>
38588>>>        // let's hide all buttons and then Show the ones we want
38588>>>        WebSet pbRender of oEditBtn to False
38589>>>        WebSet pbRender of oSaveBtn to False
38590>>>        WebSet pbRender of oCancelChangesBtn to False
38591>>>        WebSet pbRender of oDeleteBtn to False
38592>>>
38592>>>        If (NavigateData.bReadOnly) Begin
38594>>>            WebSet pbRender of oEditBtn to True
38595>>>        End
38595>>>>
38595>>>        Else Begin
38596>>>            WebSet pbRender of oSaveBtn to True
38597>>>            WebSet pbRender of oCancelChangesBtn to True
38598>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38599>>>        End
38599>>>>
38599>>>    End_Procedure
