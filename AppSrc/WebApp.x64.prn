38944>>>                // If from parent, this is a constrained drill down.
38944>>>                Case Break
38945>>>
38945>>>            Case (NavigateData.eNavigateType = nfFromChild)
38948>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38948>>>                Case Break
38949>>>
38949>>>            Case Else // must be nfUndefined
38949>>>
38949>>>        Case End
38949>>>
38949>>>        Send SetActionButtons
