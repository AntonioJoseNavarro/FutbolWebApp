37924>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37927>>>        WebSet pbRender of oNewButton to True
37928>>>        WebSet pbRender of oDetailButton to True
37929>>>
37929>>>        Case Begin
37929>>>            Case (NavigateData.eNavigateType = nfFromParent)
37931>>>                // If from parent, this is a constrained drill down
37931>>>                // If Row select does main-zoom we don't need this
37931>>>                WebSet pbRender of oDetailButton to False
37932>>>                Case Break
37933>>>
37933>>>            Case (NavigateData.eNavigateType = nfFromChild)
37936>>>                // If from child, this is a probably a parent lookup from a Zoom
37936>>>                Case Break
37937>>>
37937>>>            Case (NavigateData.eNavigateType = nfFromMain)
37940>>>                // If from main, this is a probably a main-file lookup from a Zoom
37940>>>                WebSet pbRender of oDetailButton to False
37941>>>                Case Break
37942>>>
37942>>>            Case Else // must be nfUndefined
37942>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37942>>>                // If Row select does main-zoom we don't need this
37942>>>                WebSet pbRender of oDetailButton to False
37943>>>
37943>>>        Case End
37943>>>
37943>>>    End_Procedure
37944>>>
37944>>>
37944>>>End_Object
