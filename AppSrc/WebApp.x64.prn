37627>>>>>// ---------------------------------------------------------------
37627>>>>>// Codigo de bandera (flagcdn.com) a partir de una nacionalidad o pais.
37627>>>>>// Devuelve "" si no se reconoce.
37627>>>>>// ---------------------------------------------------------------
37627>>>>>Function CodigoBandera Global String sNac Returns String
37629>>>>>    String sTexto sCod
37629>>>>>
37629>>>>>    Move (Trim(sNac)) to sTexto
37630>>>>>    Move "" to sCod
37631>>>>>
37631>>>>>    Case Begin
37631>>>>>        Case (Left(sTexto, 4) = "Espa")
37633>>>>>            Move "es" to sCod
37634>>>>>            Case Break
37635>>>>>        Case (Left(sTexto, 4) = "Alem")
37638>>>>>            Move "de" to sCod
37639>>>>>            Case Break
37640>>>>>        Case (Left(sTexto, 4) = "Arge")
37643>>>>>            Move "ar" to sCod
37644>>>>>            Case Break
37645>>>>>        Case (Left(sTexto, 4) = "Neer")
37648>>>>>            Move "nl" to sCod
37649>>>>>            Case Break
37650>>>>>        Case (Left(sTexto, 4) = "Ital")
37653>>>>>            Move "it" to sCod
37654>>>>>            Case Break
37655>>>>>        Case (Left(sTexto, 4) = "Belg")
37658>>>>>            Move "be" to sCod
37659>>>>>            Case Break
37660>>>>>        Case (Left(sTexto, 4) = "Bras")
37663>>>>>            Move "br" to sCod
37664>>>>>            Case Break
37665>>>>>        Case (Left(sTexto, 4) = "Fran")
37668>>>>>            Move "fr" to sCod
37669>>>>>            Case Break
37670>>>>>        Case (Left(sTexto, 4) = "Urug")
37673>>>>>            Move "uy" to sCod
37674>>>>>            Case Break
37675>>>>>        Case (Left(sTexto, 4) = "Ingl")
37678>>>>>            Move "gb-eng" to sCod
37679>>>>>            Case Break
37680>>>>>        Case (Left(sTexto, 4) = "Esco")
37683>>>>>            Move "gb-sct" to sCod
37684>>>>>            Case Break
37685>>>>>        Case (Left(sTexto, 4) = "Pola")
37688>>>>>            Move "pl" to sCod
37689>>>>>            Case Break
37690>>>>>        Case (Left(sTexto, 4) = "Eslo")
37693>>>>>            Move "si" to sCod
37694>>>>>            Case Break
37695>>>>>        Case (Left(sTexto, 4) = "Moza")
37698>>>>>            Move "mz" to sCod
37699>>>>>            Case Break
37700>>>>>        Case (Left(sTexto, 4) = "Port")
37703>>>>>            Move "pt" to sCod
37704>>>>>            Case Break
37705>>>>>        Case (Left(sTexto, 4) = "Noru")
37708>>>>>            Move "no" to sCod
37709>>>>>            Case Break
37710>>>>>        Case (Left(sTexto, 1) = "H")
37713>>>>>            // Hungaro
37713>>>>>            Move "hu" to sCod
37714>>>>>            Case Break
37715>>>>>        Case (Left(sTexto, 4) = "Colo")
37718>>>>>            Move "co" to sCod
37719>>>>>            Case Break
37720>>>>>        Case (Left(sTexto, 4) = "Egip")
37723>>>>>            Move "eg" to sCod
37724>>>>>            Case Break
37725>>>>>    Case End
37725>>>>>
37725>>>>>    Function_Return sCod
37726>>>>>End_Function
37727>>>>>
37727>>>>>// ---------------------------------------------------------------
37727>>>>>// Bandera + texto (nacionalidades y paises).
37727>>>>>// Imagenes de banderas de flagcdn.com
37727>>>>>// ---------------------------------------------------------------
37727>>>>>Function BanderaHtml Global String sNac Returns String
37729>>>>>    String sTexto sCod
37729>>>>>
37729>>>>>    Move (Trim(sNac)) to sTexto
37730>>>>>    Move (CodigoBandera(sTexto)) to sCod
37731>>>>>
37731>>>>>    If (sCod = "") Begin
37733>>>>>        Function_Return (htmlEncode(sTexto))
37734>>>>>    End
37734>>>>>>
37734>>>>>
37734>>>>>    Function_Return ('<img class="Bandera" src="https://flagcdn.com/w40/' + sCod + '.png" alt=""> ' + htmlEncode(sTexto))
37735>>>>>End_Function
37736>>>>>
37736>>>>>// ---------------------------------------------------------------
37736>>>>>// Sprint 3: etiqueta de liga con la bandera de su pais.
37736>>>>>// Ejemplo: [bandera de Espana] LaLiga
37736>>>>>// ---------------------------------------------------------------
37736>>>>>Function LigaHtml Global String sPais String sLiga Returns String
37738>>>>>    String sCod sBandera
37738>>>>>
37738>>>>>    // Sin liga (por ejemplo, entrenador sin equipo)
37738>>>>>    If (Trim(sLiga) = "") Begin
37740>>>>>        Function_Return '<span class="SinEquipo">-</span>'
37741>>>>>    End
37741>>>>>>
37741>>>>>
37741>>>>>    Move (CodigoBandera(sPais)) to sCod
37742>>>>>    Move "" to sBandera
37743>>>>>
37743>>>>>    If (sCod <> "") Begin
37745>>>>>        Move ('<img class="Bandera" src="https://flagcdn.com/w40/' + sCod + '.png" alt="">') to sBandera
37746>>>>>    End
37746>>>>>>
37746>>>>>
37746>>>>>    Function_Return ('<span class="LigaChip">' + sBandera + htmlEncode(Trim(sLiga)) + '</span>')
37747>>>>>End_Function
37748>>>>>
37748>>>>>// ---------------------------------------------------------------
37748>>>>>// Icono de posicion + texto
37748>>>>>// Sprint 3: las posiciones no reconocidas llevan una bota como icono
37748>>>>>// ---------------------------------------------------------------
37748>>>>>Function PosicionHtml Global String sPos Returns String
37750>>>>>    String sTexto sIcono
37750>>>>>
37750>>>>>    Move (Trim(sPos)) to sTexto
37751>>>>>    // Icono por defecto (bota) para posiciones no reconocidas
37751>>>>>    Move "&#128095;" to sIcono
37752>>>>>
37752>>>>>    Case Begin
37752>>>>>        Case (Left(sTexto, 4) = "Port")
37754>>>>>            Move "&#129508;" to sIcono
37755>>>>>            Case Break
37756>>>>>        Case (Left(sTexto, 4) = "Defe")
37759>>>>>            Move "&#129521;" to sIcono
37760>>>>>            Case Break
37761>>>>>        Case (Left(sTexto, 4) = "Cent")
37764>>>>>            Move "&#127919;" to sIcono
37765>>>>>            Case Break
37766>>>>>        Case (Left(sTexto, 4) = "Dela")
37769>>>>>            Move "&#9917;" to sIcono
37770>>>>>            Case Break
37771>>>>>    Case End
37771>>>>>
37771>>>>>    Function_Return ('<span class="IconoPos">' + sIcono + '</span> ' + htmlEncode(sTexto))
37772>>>>>End_Function
37773>>>>>
37773>>>>>// ---------------------------------------------------------------
37773>>>>>// Sprint 3: clase CSS con los colores de cada club.
37773>>>>>// La usan la insignia (EquipoHtml) y la franja (JugadorHtml).
37773>>>>>// Devuelve "otro" para equipos sin colores definidos.
37773>>>>>// ---------------------------------------------------------------
37773>>>>>Function ClaseEquipo Global String sEquipo Returns String
37775>>>>>    String sTexto sClase
37775>>>>>
37775>>>>>    Move (Trim(sEquipo)) to sTexto
37776>>>>>    Move "otro" to sClase
37777>>>>>
37777>>>>>    Case Begin
37777>>>>>        Case (Left(sTexto, 4) = "Real")
37779>>>>>            Move "rm" to sClase
37780>>>>>            Case Break
37781>>>>>        Case (Left(sTexto, 4) = "FC B")
37784>>>>>            Move "fcb" to sClase
37785>>>>>            Case Break
37786>>>>>        Case (Left(sTexto, 3) = "Atl")
37789>>>>>            Move "atm" to sClase
37790>>>>>            Case Break
37791>>>>>        Case (Left(sTexto, 4) = "Manc")
37794>>>>>            Move "mci" to sClase
37795>>>>>            Case Break
37796>>>>>        Case (Left(sTexto, 4) = "Live")
37799>>>>>            Move "liv" to sClase
37800>>>>>            Case Break
37801>>>>>        Case (Left(sTexto, 4) = "Arse")
37804>>>>>            Move "ars" to sClase
37805>>>>>            Case Break
37806>>>>>    Case End
37806>>>>>
37806>>>>>    Function_Return sClase
37807>>>>>End_Function
37808>>>>>
37808>>>>>// ---------------------------------------------------------------
37808>>>>>// Insignia del equipo (iniciales con los colores del club) + texto.
37808>>>>>// Distintivo propio, NO el escudo oficial.
37808>>>>>// ---------------------------------------------------------------
37808>>>>>Function EquipoHtml Global String sEquipo Returns String
37810>>>>>    String sTexto sIni sClase
37810>>>>>
37810>>>>>    Move (Trim(sEquipo)) to sTexto
37811>>>>>
37811>>>>>    // Sprint 3: sin equipo asignado (por ejemplo, un entrenador libre)
37811>>>>>    If (sTexto = "") Begin
37813>>>>>        Function_Return '<span class="SinEquipo">Sin equipo</span>'
37814>>>>>    End
37814>>>>>>
37814>>>>>
37814>>>>>    Move (ClaseEquipo(sTexto)) to sClase
37815>>>>>
37815>>>>>    // Las iniciales coinciden con la clase (rm -> RM, fcb -> FCB...)
37815>>>>>    // Equipo nuevo sin colores definidos: insignia gris con la inicial
37815>>>>>    If (sClase = "otro") Begin
37817>>>>>        Move (Uppercase(Left(sTexto, 1))) to sIni
37818>>>>>    End
37818>>>>>>
37818>>>>>    Else Begin
37819>>>>>        Move (Uppercase(sClase)) to sIni
37820>>>>>    End
37820>>>>>>
37820>>>>>
37820>>>>>    Function_Return ('<span class="Insignia ' + sClase + '">' + sIni + '</span> <span class="EquipoNombre">' + htmlEncode(sTexto) + '</span>')
37821>>>>>End_Function
37822>>>>>
37822>>>>>// ---------------------------------------------------------------
37822>>>>>// Sprint 3: nombre completo de una persona (jugador o entrenador)
37822>>>>>// con una franja vertical de los colores de su equipo delante.
37822>>>>>// ---------------------------------------------------------------
37822>>>>>Function JugadorHtml Global String sNombre String sApellido String sEquipo Returns String
37824>>>>>    String sClase sCompleto
37824>>>>>
37824>>>>>    Move (ClaseEquipo(sEquipo)) to sClase
37825>>>>>    Move (Trim(sNombre) + " " + Trim(sApellido)) to sCompleto
37826>>>>>
37826>>>>>    Function_Return ('<span class="Franja ' + sClase + '"></span>' + htmlEncode(sCompleto))
37827>>>>>End_Function
37828>>>>>
37828>>>>>// ---------------------------------------------------------------
37828>>>>>// Sprint 3: entrenador de un equipo.
37828>>>>>// entrenador es HIJO de equipo, asi que el relate de los DD no lo trae:
37828>>>>>// se busca directamente (solo lectura) por el Index 3 (uqEntrenadorEquipo),
37828>>>>>// que es unico por EquipoID.
37828>>>>>// ---------------------------------------------------------------
37828>>>>>Function EntrenadorHtml Global Integer iEquipoID Returns String
37830>>>>>    String sNombre
37830>>>>>
37830>>>>>    If (iEquipoID = 0) Begin
37832>>>>>        Function_Return '<span class="SinEquipo">-</span>'
37833>>>>>    End
37833>>>>>>
37833>>>>>
37833>>>>>    Clear entrenador
37834>>>>>    Move iEquipoID to entrenador.EquipoID
37835>>>>>    Find EQ entrenador by Index.3
37836>>>>>>
37836>>>>>
37836>>>>>    If (Found) Begin
37838>>>>>        Move (Trim(entrenador.Nombre) + " " + Trim(entrenador.Apellido)) to sNombre
37839>>>>>        Function_Return ('<span class="EntrenadorChip">&#128203; ' + htmlEncode(sNombre) + '</span>')
37840>>>>>    End
37840>>>>>>
37840>>>>>
37840>>>>>    Function_Return '<span class="SinEquipo">Sin entrenador</span>'
37841>>>>>End_Function
37842>>>>>
37842>>>>>// ---------------------------------------------------------------
37842>>>>>// Sprint 3: plazas ocupadas de una liga ("3 / 20") con barra de ocupacion.
37842>>>>>// La barra se pinta de rojo cuando la liga esta llena.
37842>>>>>// ---------------------------------------------------------------
37842>>>>>Function PlazasHtml Global Integer iEquipos Integer iMax Returns String
37844>>>>>    Integer iPorc
37844>>>>>    String sEquipos sMax sPorc sClase
37844>>>>>
37844>>>>>    // Porcentaje de ocupacion (0-100)
37844>>>>>    If (iMax > 0) Begin
37846>>>>>        Move (iEquipos * 100 / iMax) to iPorc
37847>>>>>    End
37847>>>>>>
37847>>>>>    Else Begin
37848>>>>>        Move 0 to iPorc
37849>>>>>    End
37849>>>>>>
37849>>>>>    If (iPorc > 100) Begin
37851>>>>>        Move 100 to iPorc
37852>>>>>    End
37852>>>>>>
37852>>>>>
37852>>>>>    // Liga llena: clase extra para pintar la barra de rojo
37852>>>>>    Move "" to sClase
37853>>>>>    If ((iMax > 0) and (iEquipos >= iMax)) Begin
37855>>>>>        Move " Llena" to sClase
37856>>>>>    End
37856>>>>>>
37856>>>>>
37856>>>>>    Move iEquipos to sEquipos
37857>>>>>    Move iMax     to sMax
37858>>>>>    Move iPorc    to sPorc
37859>>>>>
37859>>>>>    Function_Return ('<span class="Plazas' + sClase + '">' + ;                     '<span class="PlazasTexto">' + sEquipos + ' / ' + sMax + '</span>' + ;                     '<span class="PlazasBarra"><span class="PlazasRelleno" style="width:' + sPorc + '%"></span></span>' + ;                     '</span>')
37860>>>>>End_Function
