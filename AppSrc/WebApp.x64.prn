38097>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38100>>>        Case Begin
38100>>>            Case (NavigateData.eNavigateType = nfFromMain)
38102>>>                // If from main, this is a propbably a main file Select to Zoom.
38102>>>                Case Break
38103>>>
38103>>>            Case (NavigateData.eNavigateType = nfFromParent)
38106>>>                // If from parent, this is a constrained drill down.
38106>>>                Case Break
38107>>>
38107>>>            Case (NavigateData.eNavigateType = nfFromChild)
38110>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38110>>>                Case Break
38111>>>
38111>>>            Case Else // must be nfUndefined
38111>>>
38111>>>        Case End
38111>>>
38111>>>        Send SetActionButtons
38112>>>
38112>>>    End_Procedure
38113>>>
38113>>>End_Object
