39568>>>        WebSet pbRender of oEditBtn to False
39569>>>        WebSet pbRender of oSaveBtn to False
39570>>>        WebSet pbRender of oCancelChangesBtn to False
39571>>>        WebSet pbRender of oDeleteBtn to False
39572>>>
39572>>>        // El boton "Ver posiciones" solo se muestra si hay un jugador cargado
39572>>>        WebSet pbRender of oVerPosicionesBtn to bHasRecord
39573>>>
39573>>>        If (NavigateData.bReadOnly) Begin
39575>>>            WebSet pbRender of oEditBtn to True
39576>>>        End
39576>>>>
39576>>>        Else Begin
39577>>>            WebSet pbRender of oSaveBtn to True
39578>>>            WebSet pbRender of oCancelChangesBtn to True
39579>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39580>>>        End
39580>>>>
