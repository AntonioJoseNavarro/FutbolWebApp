38131>>>    Procedure SetActionButtons
38134>>>        tWebNavigateData NavigateData
38134>>>        tWebNavigateData NavigateData
38134>>>        Boolean bHasRecord
38134>>>        Handle hoDD
38134>>>
38134>>>        Get Server to hoDD
38135>>>        Get GetNavigateData to NavigateData
38136>>>        Get HasRecord of hoDD to bHasRecord
38137>>>
38137>>>        // let's hide all buttons and then Show the ones we want
38137>>>        WebSet pbRender of oEditBtn to False
38138>>>        WebSet pbRender of oSaveBtn to False
38139>>>        WebSet pbRender of oCancelChangesBtn to False
38140>>>        WebSet pbRender of oDeleteBtn to False
38141>>>
38141>>>        If (NavigateData.bReadOnly) Begin
38143>>>            WebSet pbRender of oEditBtn to True
38144>>>        End
38144>>>>
38144>>>        Else Begin
38145>>>            WebSet pbRender of oSaveBtn to True
38146>>>            WebSet pbRender of oCancelChangesBtn to True
38147>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38148>>>        End
38148>>>>
38148>>>    End_Procedure
38149>>>
38149>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38152>>>        // Close after save
38152>>>        Send NavigateClose Self
38153>>>    End_Procedure
38154>>>
38154>>>    // this will close the view after a delete
38154>>>    Procedure OnViewDeleted Handle hoDDO
38157>>>        Send NavigateClose Self
38158>>>    End_Procedure
38159>>>
38159>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38162>>>        Case Begin
38162>>>            Case (NavigateData.eNavigateType = nfFromMain)
38164>>>                // If from main, this is a propbably a main file Select to Zoom.
38164>>>                Case Break
38165>>>
38165>>>            Case (NavigateData.eNavigateType = nfFromParent)
38168>>>                // If from parent, this is a constrained drill down.
38168>>>                Case Break
38169>>>
38169>>>            Case (NavigateData.eNavigateType = nfFromChild)
38172>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38172>>>                Case Break
38173>>>
38173>>>            Case Else // must be nfUndefined
38173>>>
38173>>>        Case End
38173>>>
38173>>>        Send SetActionButtons
38174>>>
38174>>>    End_Procedure
38175>>>
38175>>>End_Object
