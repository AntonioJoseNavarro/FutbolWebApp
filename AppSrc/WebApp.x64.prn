37920>>>    // Sprint 3: construye el cromo de la cabecera con los datos de la posicion.
37920>>>    // Estructura: franja azul | nombre + tipo | icono grande en un circulo
37920>>>    Procedure ActualizarCabecera
37923>>>        String sPos sTipo sHtml
37923>>>
37923>>>        Get Field_Current_Value of oposicion_DD Field posicion.Nombre to sPos
37924>>>        Move (Trim(sPos)) to sPos
37925>>>
37925>>>        // Posicion nueva (sin nombre todavia)
37925>>>        If (sPos = "") Begin
37927>>>            Move ('<div class="Cromo"><div class="CromoFranja otro"></div>' + ;                  '<div class="CromoInfo"><div class="CromoNombre">Nueva posici&oacute;n</div>' + ;                  '<div class="CromoAviso">Escribe el nombre de la posici&oacute;n</div></div></div>') to sHtml
37928>>>        End
37928>>>>
37928>>>        Else Begin
37929>>>            // Tipo: oficial (las 4 del terreno de juego) o personalizada
37929>>>            Move "Personalizada" to sTipo
37930>>>            If ((Left(sPos, 4) = "Port") or (Left(sPos, 4) = "Defe") or (Left(sPos, 4) = "Cent") or (Left(sPos, 4) = "Dela")) Begin
37932>>>                Move "Oficial" to sTipo
37933>>>            End
37933>>>>
37933>>>
37933>>>            Move ('<div class="Cromo"><div class="CromoFranja posicion"></div>' + ;                  '<div class="CromoInfo">' + ;                  '<div class="CromoNombre">' + htmlEncode(sPos) + '</div>' + ;                  '<div class="CromoDatos">' + ;                  '<div class="CromoDato"><div class="CromoEtiqueta">Tipo</div>' + sTipo + '</div>' + ;                  '</div></div>' + ;                  '<div class="CromoDorsal"><span class="CromoIconoPos">' + IconoPosicion(sPos) + '</span></div>' + ;                  '</div>') to sHtml
37934>>>        End
37934>>>>
37934>>>
37934>>>        Send UpdateHTML of oCabecera sHtml
37935>>>    End_Procedure
37936>>>
