37940>>>        Get GetNavigateData to NavigateData
37941>>>        Get HasRecord of hoDD to bHasRecord
37942>>>
37942>>>        // let's hide all buttons and then Show the ones we want
37942>>>        WebSet pbRender of oEditBtn to False
37943>>>        WebSet pbRender of oSaveBtn to False
37944>>>        WebSet pbRender of oCancelChangesBtn to False
37945>>>        WebSet pbRender of oDeleteBtn to False
37946>>>
37946>>>        If (NavigateData.bReadOnly) Begin
37948>>>            WebSet pbRender of oEditBtn to True
37949>>>        End
37949>>>>
37949>>>        Else Begin
37950>>>            WebSet pbRender of oSaveBtn to True
37951>>>            WebSet pbRender of oCancelChangesBtn to True
37952>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37953>>>        End
37953>>>>
37953>>>    End_Procedure
