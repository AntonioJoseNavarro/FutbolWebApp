37926>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37929>>>        WebSet pbRender of oNewButton to True
37930>>>        WebSet pbRender of oDetailButton to True
37931>>>
37931>>>        Case Begin
37931>>>            Case (NavigateData.eNavigateType = nfFromParent)
37933>>>                // If from parent, this is a constrained drill down
37933>>>                // If Row select does main-zoom we don't need this
37933>>>                WebSet pbRender of oDetailButton to False
37934>>>                Case Break
37935>>>
37935>>>            Case (NavigateData.eNavigateType = nfFromChild)
37938>>>                // If from child, this is a probably a parent lookup from a Zoom
37938>>>                Case Break
37939>>>
37939>>>            Case (NavigateData.eNavigateType = nfFromMain)
37942>>>                // If from main, this is a probably a main-file lookup from a Zoom
37942>>>                WebSet pbRender of oDetailButton to False
37943>>>                Case Break
37944>>>
37944>>>            Case Else // must be nfUndefined
37944>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
37944>>>                // If Row select does main-zoom we don't need this
37944>>>                WebSet pbRender of oDetailButton to False
37945>>>
37945>>>        Case End
37945>>>
37945>>>    End_Procedure
37946>>>
37946>>>
37946>>>End_Object
