39032>>>                Case Break
39033>>>
39033>>>            Case Else // must be nfUndefined
39033>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
39033>>>                // If Row select does main-zoom we don't need this
39033>>>                WebSet pbRender of oDetailButton to False
39034>>>
39034>>>        Case End
