37513>>>        WebSet pbRender of oEditBtn to False
37514>>>        WebSet pbRender of oSaveBtn to False
37515>>>        WebSet pbRender of oCancelChangesBtn to False
37516>>>        WebSet pbRender of oDeleteBtn to False
37517>>>
37517>>>        If (NavigateData.bReadOnly) Begin
37519>>>            WebSet pbRender of oEditBtn to True
37520>>>        End
37520>>>>
37520>>>        Else Begin
