37608>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37611>>>        Case Begin
37611>>>            Case (NavigateData.eNavigateType = nfFromMain)
37613>>>                // If from main, this is a propbably a main file Select to Zoom.
37613>>>                Case Break
37614>>>
37614>>>            Case (NavigateData.eNavigateType = nfFromParent)
37617>>>                // If from parent, this is a constrained drill down.
37617>>>                Case Break
37618>>>
37618>>>            Case (NavigateData.eNavigateType = nfFromChild)
37621>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37621>>>                Case Break
37622>>>
37622>>>            Case Else // must be nfUndefined
37622>>>
37622>>>        Case End
37622>>>
37622>>>        Send SetActionButtons
