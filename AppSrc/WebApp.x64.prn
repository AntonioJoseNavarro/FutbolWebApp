38703>>>    // Sprint 3: construye el cromo de la cabecera con los datos actuales
38703>>>    // de los DDO (equipo y, por el relate, su liga).
38703>>>    // Estructura: franja del club | nombre + datos con etiquetas | insignia grande
38703>>>    Procedure ActualizarCabecera
38706>>>        String sEquipo sLiga sPais sClase sIni sHtml
38706>>>        Integer iEquipoID
38706>>>
38706>>>        Get Field_Current_Value of oequipo_DD Field equipo.ID     to iEquipoID
38707>>>        Get Field_Current_Value of oequipo_DD Field equipo.Nombre to sEquipo
38708>>>        Get File_Field_Current_Value of oequipo_DD File_Field liga.Nombre to sLiga
38709>>>        Get File_Field_Current_Value of oequipo_DD File_Field liga.Pais   to sPais
38710>>>
38710>>>        // Equipo nuevo (sin nombre todavia)
38710>>>        If (Trim(sEquipo) = "") Begin
38712>>>            Move ('<div class="Cromo"><div class="CromoFranja otro"></div>' + ;                  '<div class="CromoInfo"><div class="CromoNombre">Nuevo equipo</div>' + ;                  '<div class="CromoAviso">Escribe su nombre y elige su liga</div></div></div>') to sHtml
38713>>>        End
38713>>>>
38713>>>        Else Begin
38714>>>            Move (ClaseEquipo(sEquipo)) to sClase
38715>>>
38715>>>            // Iniciales de la insignia grande (o la inicial si no tiene colores)
38715>>>            If (sClase = "otro") Begin
38717>>>                Move (Uppercase(Left(Trim(sEquipo), 1))) to sIni
38718>>>            End
38718>>>>
38718>>>            Else Begin
38719>>>                Move (Uppercase(sClase)) to sIni
38720>>>            End
38720>>>>
38720>>>
38720>>>            // Franja + nombre
38720>>>            Move ('<div class="Cromo"><div class="CromoFranja ' + sClase + '"></div>' + ;                  '<div class="CromoInfo">' + ;                  '<div class="CromoNombre">' + htmlEncode(Trim(sEquipo)) + '</div>' + ;                  '<div class="CromoDatos">') to sHtml
38721>>>
38721>>>            // Datos con su etiqueta encima
38721>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Liga</div>' + LigaHtml(sPais, sLiga) + '</div>') to sHtml
38722>>>            If (Trim(sPais) <> "") Begin
38724>>>                Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Pa&iacute;s</div>' + BanderaHtml(sPais) + '</div>') to sHtml
38725>>>            End
38725>>>>
38725>>>            If (iEquipoID <> 0) Begin
38727>>>                Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Entrenador</div>' + EntrenadorHtml(iEquipoID) + '</div>') to sHtml
38728>>>            End
38728>>>>
38728>>>            Move (sHtml + '</div></div>') to sHtml
38729>>>
38729>>>            // Insignia del club en grande a la derecha
38729>>>            Move (sHtml + '<div class="CromoDorsal">' + ;                  '<span class="Insignia ' + sClase + ' CromoInsigniaGrande">' + sIni + '</span>' + ;                  '</div></div>') to sHtml
38730>>>        End
38730>>>>
38730>>>
38730>>>        Send UpdateHTML of oCabecera sHtml
38731>>>    End_Procedure
38732>>>
38732>>>    Procedure SetActionButtons
38735>>>        tWebNavigateData NavigateData
38735>>>        tWebNavigateData NavigateData
38735>>>        Boolean bHasRecord
38735>>>        Handle hoDD
38735>>>
38735>>>        Get Server to hoDD
38736>>>        Get GetNavigateData to NavigateData
38737>>>        Get HasRecord of hoDD to bHasRecord
38738>>>
38738>>>        // let's hide all buttons and then Show the ones we want
38738>>>        WebSet pbRender of oEditBtn to False
38739>>>        WebSet pbRender of oSaveBtn to False
38740>>>        WebSet pbRender of oCancelChangesBtn to False
38741>>>        WebSet pbRender of oDeleteBtn to False
38742>>>
38742>>>        If (NavigateData.bReadOnly) Begin
38744>>>            WebSet pbRender of oEditBtn to True
38745>>>        End
38745>>>>
38745>>>        Else Begin
38746>>>            WebSet pbRender of oSaveBtn to True
38747>>>            WebSet pbRender of oCancelChangesBtn to True
38748>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38749>>>        End
38749>>>>
38749>>>    End_Procedure
