37869>>>        Procedure OnRowClick String sRowId
37872>>>            tWebNavigateData NavigateData
37872>>>            tWebNavigateData NavigateData
37872>>>            Get GetNavigateData to NavigateData
37873>>>
37873>>>            Case Begin
37873>>>                Case (NavigateData.eNavigateType = nfFromParent)
37875>>>                    Send NavigateForward of oZoomPosicion Self
37876>>>                    Case Break
37877>>>
37877>>>                Case (NavigateData.eNavigateType = nfFromChild)
37880>>>                    Send NavigateClose Self
37881>>>                    Case Break
37882>>>
37882>>>                Case (NavigateData.eNavigateType = nfFromMain)
37885>>>                    Send NavigateClose Self
37886>>>                    Case Break
37887>>>
37887>>>                Case Else // must be nfUndefined
37887>>>                    Send NavigateForward of oZoomPosicion Self
37888>>>
37888>>>            Case End
37888>>>        End_Procedure
