38321>>>    // Sprint 3: construye el cromo de la cabecera con los datos de la liga.
38321>>>    // Estructura: franja dorada | nombre + datos con etiquetas | bandera grande
38321>>>    Procedure ActualizarCabecera
38324>>>        String sLiga sPais sCod sHtml
38324>>>        Integer iEquipos iMax
38324>>>
38324>>>        Get Field_Current_Value of oliga_DD Field liga.Nombre     to sLiga
38325>>>        Get Field_Current_Value of oliga_DD Field liga.Pais       to sPais
38326>>>        Get Field_Current_Value of oliga_DD Field liga.Equipos    to iEquipos
38327>>>        Get Field_Current_Value of oliga_DD Field liga.EquiposMax to iMax
38328>>>
38328>>>        // Liga nueva (sin nombre todavia)
38328>>>        If (Trim(sLiga) = "") Begin
38330>>>            Move ('<div class="Cromo"><div class="CromoFranja otro"></div>' + ;                  '<div class="CromoInfo"><div class="CromoNombre">Nueva liga</div>' + ;                  '<div class="CromoAviso">Escribe su nombre, su pa&iacute;s y el m&aacute;ximo de equipos</div></div></div>') to sHtml
38331>>>        End
38331>>>>
38331>>>        Else Begin
38332>>>            // Franja dorada + nombre
38332>>>            Move ('<div class="Cromo"><div class="CromoFranja oro"></div>' + ;                  '<div class="CromoInfo">' + ;                  '<div class="CromoNombre">' + htmlEncode(Trim(sLiga)) + '</div>' + ;                  '<div class="CromoDatos">') to sHtml
38333>>>
38333>>>            // Datos con su etiqueta encima
38333>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Pa&iacute;s</div>' + BanderaHtml(sPais) + '</div>') to sHtml
38334>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Plazas</div>' + PlazasHtml(iEquipos, iMax) + '</div>') to sHtml
38335>>>            Move (sHtml + '</div></div>') to sHtml
38336>>>
38336>>>            // Bandera grande del pais a la derecha (o un trofeo si no se reconoce)
38336>>>            Move (CodigoBandera(sPais)) to sCod
38337>>>            If (sCod <> "") Begin
38339>>>                Move (sHtml + '<div class="CromoDorsal">' + ;                      '<img class="CromoBanderaGrande" src="https://flagcdn.com/w160/' + sCod + '.png" alt="">' + ;                      '</div></div>') to sHtml
38340>>>            End
38340>>>>
38340>>>            Else Begin
38341>>>                Move (sHtml + '<div class="CromoDorsal">' + ;                      '<span class="CromoNumero CromoIcono">&#127942;</span>' + ;                      '</div></div>') to sHtml
38342>>>            End
38342>>>>
38342>>>        End
38342>>>>
38342>>>
38342>>>        Send UpdateHTML of oCabecera sHtml
38343>>>    End_Procedure
38344>>>
38344>>>    Procedure SetActionButtons
38347>>>        tWebNavigateData NavigateData
38347>>>        tWebNavigateData NavigateData
38347>>>        Boolean bHasRecord
38347>>>        Handle hoDD
38347>>>
38347>>>        Get Server to hoDD
38348>>>        Get GetNavigateData to NavigateData
38349>>>        Get HasRecord of hoDD to bHasRecord
38350>>>
38350>>>        // let's hide all buttons and then Show the ones we want
38350>>>        WebSet pbRender of oEditBtn to False
38351>>>        WebSet pbRender of oSaveBtn to False
38352>>>        WebSet pbRender of oCancelChangesBtn to False
38353>>>        WebSet pbRender of oDeleteBtn to False
38354>>>
38354>>>        If (NavigateData.bReadOnly) Begin
38356>>>            WebSet pbRender of oEditBtn to True
38357>>>        End
38357>>>>
38357>>>        Else Begin
38358>>>            WebSet pbRender of oSaveBtn to True
38359>>>            WebSet pbRender of oCancelChangesBtn to True
38360>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38361>>>        End
38361>>>>
38361>>>    End_Procedure
38362>>>
38362>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38365>>>        // Close after save
38365>>>        Send NavigateClose Self
38366>>>    End_Procedure
38367>>>
38367>>>    // this will close the view after a delete
38367>>>    Procedure OnViewDeleted Handle hoDDO
38370>>>        Send NavigateClose Self
38371>>>    End_Procedure
