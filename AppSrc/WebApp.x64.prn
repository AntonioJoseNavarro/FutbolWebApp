37871>>>        Procedure OnRowClick String sRowId
37874>>>            tWebNavigateData NavigateData
37874>>>            tWebNavigateData NavigateData
37874>>>            Get GetNavigateData to NavigateData
37875>>>
37875>>>            Case Begin
37875>>>                Case (NavigateData.eNavigateType = nfFromParent)
37877>>>                    Send NavigateForward of oZoomPosicion Self
37878>>>                    Case Break
37879>>>
37879>>>                Case (NavigateData.eNavigateType = nfFromChild)
37882>>>                    Send NavigateClose Self
37883>>>                    Case Break
37884>>>
37884>>>                Case (NavigateData.eNavigateType = nfFromMain)
37887>>>                    Send NavigateClose Self
37888>>>                    Case Break
37889>>>
37889>>>                Case Else // must be nfUndefined
37889>>>                    Send NavigateForward of oZoomPosicion Self
37890>>>
37890>>>            Case End
37890>>>        End_Procedure
