38381>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38384>>>        WebSet pbRender of oNewButton to True
38385>>>        WebSet pbRender of oDetailButton to True
38386>>>
38386>>>        Case Begin
38386>>>            Case (NavigateData.eNavigateType = nfFromParent)
38388>>>                // If from parent, this is a constrained drill down
38388>>>                // If Row select does main-zoom we don't need this
38388>>>                WebSet pbRender of oDetailButton to False
38389>>>                Case Break
38390>>>
38390>>>            Case (NavigateData.eNavigateType = nfFromChild)
38393>>>                // If from child, this is a probably a parent lookup from a Zoom
38393>>>                Case Break
38394>>>
38394>>>            Case (NavigateData.eNavigateType = nfFromMain)
38397>>>                // If from main, this is a probably a main-file lookup from a Zoom
38397>>>                WebSet pbRender of oDetailButton to False
38398>>>                Case Break
38399>>>
38399>>>            Case Else // must be nfUndefined
38399>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38399>>>                // If Row select does main-zoom we don't need this
38399>>>                WebSet pbRender of oDetailButton to False
38400>>>
38400>>>        Case End
38400>>>
38400>>>    End_Procedure
