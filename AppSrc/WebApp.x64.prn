37627>>>>>// ---------------------------------------------------------------
37627>>>>>Function BanderaHtml Global String sNac Returns String
37629>>>>>    String sTexto sCod
37629>>>>>
37629>>>>>    Move (Trim(sNac)) to sTexto
37630>>>>>    Move "" to sCod
37631>>>>>
37631>>>>>    Case Begin
37631>>>>>        Case (Left(sTexto, 4) = "Espa")
37633>>>>>            Move "es" to sCod
37634>>>>>            Case Break
37635>>>>>        Case (Left(sTexto, 4) = "Alem")
37638>>>>>            Move "de" to sCod
37639>>>>>            Case Break
37640>>>>>        Case (Left(sTexto, 4) = "Arge")
37643>>>>>            Move "ar" to sCod
37644>>>>>            Case Break
37645>>>>>        Case (Left(sTexto, 4) = "Neer")
37648>>>>>            Move "nl" to sCod
37649>>>>>            Case Break
37650>>>>>        Case (Left(sTexto, 4) = "Ital")
37653>>>>>            Move "it" to sCod
37654>>>>>            Case Break
37655>>>>>        Case (Left(sTexto, 4) = "Belg")
37658>>>>>            Move "be" to sCod
37659>>>>>            Case Break
37660>>>>>        Case (Left(sTexto, 4) = "Bras")
37663>>>>>            Move "br" to sCod
37664>>>>>            Case Break
37665>>>>>        Case (Left(sTexto, 4) = "Fran")
37668>>>>>            Move "fr" to sCod
37669>>>>>            Case Break
37670>>>>>        Case (Left(sTexto, 4) = "Urug")
37673>>>>>            Move "uy" to sCod
37674>>>>>            Case Break
37675>>>>>        Case (Left(sTexto, 4) = "Ingl")
37678>>>>>            Move "gb-eng" to sCod
37679>>>>>            Case Break
37680>>>>>        Case (Left(sTexto, 4) = "Esco")
37683>>>>>            Move "gb-sct" to sCod
37684>>>>>            Case Break
37685>>>>>        Case (Left(sTexto, 4) = "Pola")
37688>>>>>            Move "pl" to sCod
37689>>>>>            Case Break
37690>>>>>        Case (Left(sTexto, 4) = "Eslo")
37693>>>>>            Move "si" to sCod
37694>>>>>            Case Break
37695>>>>>        Case (Left(sTexto, 4) = "Moza")
37698>>>>>            Move "mz" to sCod
37699>>>>>            Case Break
37700>>>>>        Case (Left(sTexto, 4) = "Port")
37703>>>>>            Move "pt" to sCod
37704>>>>>            Case Break
37705>>>>>        Case (Left(sTexto, 4) = "Noru")
37708>>>>>            Move "no" to sCod
37709>>>>>            Case Break
37710>>>>>        Case (Left(sTexto, 1) = "H")
37713>>>>>            // Hungaro
37713>>>>>            Move "hu" to sCod
37714>>>>>            Case Break
37715>>>>>        Case (Left(sTexto, 4) = "Colo")
37718>>>>>            Move "co" to sCod
37719>>>>>            Case Break
37720>>>>>        Case (Left(sTexto, 4) = "Egip")
37723>>>>>            Move "eg" to sCod
37724>>>>>            Case Break
37725>>>>>    Case End
37725>>>>>
37725>>>>>    If (sCod = "") Begin
37727>>>>>        Function_Return (htmlEncode(sTexto))
37728>>>>>    End
37728>>>>>>
37728>>>>>
37728>>>>>    Function_Return ('<img class="Bandera" src="https://flagcdn.com/w40/' + sCod + '.png" alt=""> ' + htmlEncode(sTexto))
37729>>>>>End_Function
37730>>>>>
37730>>>>>// ---------------------------------------------------------------
37730>>>>>// Icono de posicion + texto
37730>>>>>// ---------------------------------------------------------------
37730>>>>>Function PosicionHtml Global String sPos Returns String
37732>>>>>    String sTexto sIcono
37732>>>>>
37732>>>>>    Move (Trim(sPos)) to sTexto
37733>>>>>    Move "" to sIcono
37734>>>>>
37734>>>>>    Case Begin
37734>>>>>        Case (Left(sTexto, 4) = "Port")
37736>>>>>            Move "&#129508;" to sIcono
37737>>>>>            Case Break
37738>>>>>        Case (Left(sTexto, 4) = "Defe")
37741>>>>>            Move "&#129521;" to sIcono
37742>>>>>            Case Break
37743>>>>>        Case (Left(sTexto, 4) = "Cent")
37746>>>>>            Move "&#127919;" to sIcono
37747>>>>>            Case Break
37748>>>>>        Case (Left(sTexto, 4) = "Dela")
37751>>>>>            Move "&#9917;" to sIcono
37752>>>>>            Case Break
37753>>>>>    Case End
37753>>>>>
37753>>>>>    If (sIcono = "") Begin
37755>>>>>        Function_Return (htmlEncode(sTexto))
37756>>>>>    End
37756>>>>>>
37756>>>>>
37756>>>>>    Function_Return ('<span class="IconoPos">' + sIcono + '</span> ' + htmlEncode(sTexto))
37757>>>>>End_Function
37758>>>>>
37758>>>>>// ---------------------------------------------------------------
37758>>>>>// Insignia del equipo (iniciales con los colores del club) + texto.
37758>>>>>// Distintivo propio, NO el escudo oficial.
37758>>>>>// ---------------------------------------------------------------
37758>>>>>Function EquipoHtml Global String sEquipo Returns String
37760>>>>>    String sTexto sIni sClase
37760>>>>>
37760>>>>>    Move (Trim(sEquipo)) to sTexto
37761>>>>>    Move "" to sIni
37762>>>>>    Move "" to sClase
37763>>>>>
37763>>>>>    Case Begin
37763>>>>>        Case (Left(sTexto, 4) = "Real")
37765>>>>>            Move "RM" to sIni
37766>>>>>            Move "rm" to sClase
37767>>>>>            Case Break
37768>>>>>        Case (Left(sTexto, 4) = "FC B")
37771>>>>>            Move "FCB" to sIni
37772>>>>>            Move "fcb" to sClase
37773>>>>>            Case Break
37774>>>>>        Case (Left(sTexto, 3) = "Atl")
37777>>>>>            Move "ATM" to sIni
37778>>>>>            Move "atm" to sClase
37779>>>>>            Case Break
37780>>>>>        Case (Left(sTexto, 4) = "Manc")
37783>>>>>            Move "MCI" to sIni
37784>>>>>            Move "mci" to sClase
37785>>>>>            Case Break
37786>>>>>        Case (Left(sTexto, 4) = "Live")
37789>>>>>            Move "LIV" to sIni
37790>>>>>            Move "liv" to sClase
37791>>>>>            Case Break
37792>>>>>        Case (Left(sTexto, 4) = "Arse")
37795>>>>>            Move "ARS" to sIni
37796>>>>>            Move "ars" to sClase
37797>>>>>            Case Break
37798>>>>>    Case End
37798>>>>>
37798>>>>>    // Equipo nuevo sin insignia definida: insignia gris con la inicial
37798>>>>>    If (sIni = "") Begin
37800>>>>>        Move (Uppercase(Left(sTexto, 1))) to sIni
37801>>>>>        Move "otro" to sClase
37802>>>>>    End
37802>>>>>>
37802>>>>>
37802>>>>>    Function_Return ('<span class="Insignia ' + sClase + '">' + sIni + '</span> ' + htmlEncode(sTexto))
37803>>>>>End_Function
