37876>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37879>>>        Case Begin
37879>>>            Case (NavigateData.eNavigateType = nfFromMain)
37881>>>                // If from main, this is a propbably a main file Select to Zoom.
37881>>>                Case Break
37882>>>
37882>>>            Case (NavigateData.eNavigateType = nfFromParent)
37885>>>                // If from parent, this is a constrained drill down.
37885>>>                Case Break
37886>>>
37886>>>            Case (NavigateData.eNavigateType = nfFromChild)
37889>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37889>>>                Case Break
37890>>>
37890>>>            Case Else // must be nfUndefined
37890>>>
37890>>>        Case End
37890>>>
37890>>>        Send SetActionButtons
37891>>>        // Sprint 3: dibujar el cromo al abrir la ficha
37891>>>        Send ActualizarCabecera
37892>>>
37892>>>    End_Procedure
37893>>>
37893>>>End_Object
