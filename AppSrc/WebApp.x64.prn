39614>>>    // Sprint 3: construye el cromo de la cabecera con los datos actuales
39614>>>    // de los DDO (jugador y, por el relate, su equipo y su liga).
39614>>>    // Estructura: franja del club | nombre + datos con etiquetas | dorsal
39614>>>    Procedure ActualizarCabecera
39617>>>        String sNombre sApellido sNac sEquipo sLiga sPais sClase sHtml sID sMarca
39617>>>        Integer iID iEquipoID
39617>>>
39617>>>        Get Field_Current_Value of ojugador_DD Field jugador.ID           to iID
39618>>>        Get Field_Current_Value of ojugador_DD Field jugador.Nombre       to sNombre
39619>>>        Get Field_Current_Value of ojugador_DD Field jugador.Apellido     to sApellido
39620>>>        Get Field_Current_Value of ojugador_DD Field jugador.Nacionalidad to sNac
39621>>>        Get File_Field_Current_Value of ojugador_DD File_Field equipo.ID     to iEquipoID
39622>>>        Get File_Field_Current_Value of ojugador_DD File_Field equipo.Nombre to sEquipo
39623>>>        Get File_Field_Current_Value of ojugador_DD File_Field liga.Nombre   to sLiga
39624>>>        Get File_Field_Current_Value of ojugador_DD File_Field liga.Pais     to sPais
39625>>>
39625>>>        // Jugador nuevo (sin nombre todavia)
39625>>>        If ((Trim(sNombre) = "") and (Trim(sApellido) = "")) Begin
39627>>>            Move ('<div class="Cromo"><div class="CromoFranja otro"></div>' + ;                  '<div class="CromoInfo"><div class="CromoNombre">Nuevo jugador</div>' + ;                  '<div class="CromoAviso">Rellena sus datos y elige su equipo</div></div></div>') to sHtml
39628>>>        End
39628>>>>
39628>>>        Else Begin
39629>>>            Move (ClaseEquipo(sEquipo)) to sClase
39630>>>
39630>>>            // Marca de agua: iniciales del club (o la inicial si no tiene colores)
39630>>>            Move "" to sMarca
39631>>>            If (Trim(sEquipo) <> "") Begin
39633>>>                If (sClase = "otro") Begin
39635>>>                    Move (Uppercase(Left(Trim(sEquipo), 1))) to sMarca
39636>>>                End
39636>>>>
39636>>>                Else Begin
39637>>>                    Move (Uppercase(sClase)) to sMarca
39638>>>                End
39638>>>>
39638>>>            End
39638>>>>
39638>>>
39638>>>            Move iID to sID
39639>>>
39639>>>            // Franja + nombre
39639>>>            Move ('<div class="Cromo"><div class="CromoFranja ' + sClase + '"></div>' + ;                  '<div class="CromoInfo">' + ;                  '<div class="CromoNombre">' + htmlEncode(Trim(sNombre) + " " + Trim(sApellido)) + '</div>' + ;                  '<div class="CromoDatos">') to sHtml
39640>>>
39640>>>            // Datos con su etiqueta encima
39640>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Nacionalidad</div>' + BanderaHtml(sNac) + '</div>') to sHtml
39641>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Equipo</div>' + EquipoHtml(sEquipo) + '</div>') to sHtml
39642>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Liga</div>' + LigaHtml(sPais, sLiga) + '</div>') to sHtml
39643>>>            If (iEquipoID <> 0) Begin
39645>>>                Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Entrenador</div>' + EntrenadorHtml(iEquipoID) + '</div>') to sHtml
39646>>>            End
39646>>>>
39646>>>            Move (sHtml + '</div></div>') to sHtml
39647>>>
39647>>>            // Dorsal grande con las iniciales del club de fondo
39647>>>            Move (sHtml + '<div class="CromoDorsal">' + ;                  '<span class="CromoMarca">' + sMarca + '</span>' + ;                  '<span class="CromoNumero"><small>#</small>' + sID + '</span>' + ;                  '</div></div>') to sHtml
39648>>>        End
39648>>>>
39648>>>
39648>>>        Send UpdateHTML of oCabecera sHtml
39649>>>    End_Procedure
