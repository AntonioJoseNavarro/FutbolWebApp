37304>>>    Procedure DoLogin
37307>>>        String sLoginName sPassword sPrevStateHash
37307>>>        Boolean bResult
37307>>>        
37307>>>        WebGet psValue of oLoginName to sLoginName
37308>>>        WebGet psValue of oPassword to sPassword
37309>>>        
37309>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37310>>>        
37310>>>        If (bResult) Begin
37312>>>            Send Hide of oLogin
37313>>>            Send ShowHeader of ghoWebApp
37314>>>            WebSet psCSSClass of ghoWebApp to ""
37315>>>            
37315>>>            WebGet psPrevStateHash to sPrevStateHash
37316>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
37317>>>            
37317>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37317>>>            WebSet psValue of oLoginName to ""
37318>>>            WebSet psValue of oPassword  to ""
37319>>>            WebSet pbVisible of oWarning to False
37320>>>        End
37320>>>>
37320>>>        Else Begin
37321>>>            WebSet pbVisible of oWarning to True
37322>>>        End
37322>>>>
37322>>>    End_Procedure
