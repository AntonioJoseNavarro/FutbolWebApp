38560>>>                // If from main, this is a propbably a main file Select to Zoom.
38560>>>                Case Break
38561>>>
38561>>>            Case (NavigateData.eNavigateType = nfFromParent)
38564>>>                // If from parent, this is a constrained drill down.
38564>>>                Case Break
38565>>>
38565>>>            Case (NavigateData.eNavigateType = nfFromChild)
38568>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38568>>>                Case Break
38569>>>
38569>>>            Case Else // must be nfUndefined
38569>>>
38569>>>        Case End
38569>>>
38569>>>        Send SetActionButtons
38570>>>
38570>>>    End_Procedure
