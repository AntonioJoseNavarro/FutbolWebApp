37964>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37967>>>        Case Begin
37967>>>            Case (NavigateData.eNavigateType = nfFromMain)
37969>>>                // If from main, this is a propbably a main file Select to Zoom.
37969>>>                Case Break
37970>>>
37970>>>            Case (NavigateData.eNavigateType = nfFromParent)
37973>>>                // If from parent, this is a constrained drill down.
37973>>>                Case Break
37974>>>
37974>>>            Case (NavigateData.eNavigateType = nfFromChild)
37977>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37977>>>                Case Break
37978>>>
37978>>>            Case Else // must be nfUndefined
37978>>>
37978>>>        Case End
37978>>>
37978>>>        Send SetActionButtons
37979>>>        // Sprint 3: dibujar el cromo al abrir la ficha
37979>>>        Send ActualizarCabecera
37980>>>
37980>>>    End_Procedure
