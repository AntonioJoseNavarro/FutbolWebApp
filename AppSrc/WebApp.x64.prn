38760>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38763>>>        Case Begin
38763>>>            Case (NavigateData.eNavigateType = nfFromMain)
38765>>>                // If from main, this is a propbably a main file Select to Zoom.
38765>>>                Case Break
38766>>>
38766>>>            Case (NavigateData.eNavigateType = nfFromParent)
38769>>>                // If from parent, this is a constrained drill down.
38769>>>                Case Break
38770>>>
38770>>>            Case (NavigateData.eNavigateType = nfFromChild)
38773>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38773>>>                Case Break
38774>>>
38774>>>            Case Else // must be nfUndefined
38774>>>
38774>>>        Case End
38774>>>
38774>>>        Send SetActionButtons
38775>>>        // Sprint 3: dibujar el cromo al abrir la ficha
38775>>>        Send ActualizarCabecera
38776>>>
38776>>>    End_Procedure
38777>>>
38777>>>End_Object
