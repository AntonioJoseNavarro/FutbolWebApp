39351>>>    // Sprint 3: construye el cromo de la cabecera con los datos actuales
39351>>>    // de los DDO (jugador y, por el relate, su equipo y su liga).
39351>>>    // Estructura: franja del club | nombre + datos con etiquetas | dorsal
39351>>>    Procedure ActualizarCabecera
39354>>>        String sNombre sApellido sNac sEquipo sLiga sPais sClase sHtml sID sMarca
39354>>>        Integer iID iEquipoID
39354>>>
39354>>>        Get Field_Current_Value of ojugador_DD Field jugador.ID           to iID
39355>>>        Get Field_Current_Value of ojugador_DD Field jugador.Nombre       to sNombre
39356>>>        Get Field_Current_Value of ojugador_DD Field jugador.Apellido     to sApellido
39357>>>        Get Field_Current_Value of ojugador_DD Field jugador.Nacionalidad to sNac
39358>>>        Get File_Field_Current_Value of ojugador_DD File_Field equipo.ID     to iEquipoID
39359>>>        Get File_Field_Current_Value of ojugador_DD File_Field equipo.Nombre to sEquipo
39360>>>        Get File_Field_Current_Value of ojugador_DD File_Field liga.Nombre   to sLiga
39361>>>        Get File_Field_Current_Value of ojugador_DD File_Field liga.Pais     to sPais
39362>>>
39362>>>        // Jugador nuevo (sin nombre todavia)
39362>>>        If ((Trim(sNombre) = "") and (Trim(sApellido) = "")) Begin
39364>>>            Move ('<div class="Cromo"><div class="CromoFranja otro"></div>' + ;                  '<div class="CromoInfo"><div class="CromoNombre">Nuevo jugador</div>' + ;                  '<div class="CromoAviso">Rellena sus datos y elige su equipo</div></div></div>') to sHtml
39365>>>        End
39365>>>>
39365>>>        Else Begin
39366>>>            Move (ClaseEquipo(sEquipo)) to sClase
39367>>>
39367>>>            // Marca de agua: iniciales del club (o la inicial si no tiene colores)
39367>>>            Move "" to sMarca
39368>>>            If (Trim(sEquipo) <> "") Begin
39370>>>                If (sClase = "otro") Begin
39372>>>                    Move (Uppercase(Left(Trim(sEquipo), 1))) to sMarca
39373>>>                End
39373>>>>
39373>>>                Else Begin
39374>>>                    Move (Uppercase(sClase)) to sMarca
39375>>>                End
39375>>>>
39375>>>            End
39375>>>>
39375>>>
39375>>>            Move iID to sID
39376>>>
39376>>>            // Franja + nombre
39376>>>            Move ('<div class="Cromo"><div class="CromoFranja ' + sClase + '"></div>' + ;                  '<div class="CromoInfo">' + ;                  '<div class="CromoNombre">' + htmlEncode(Trim(sNombre) + " " + Trim(sApellido)) + '</div>' + ;                  '<div class="CromoDatos">') to sHtml
39377>>>
39377>>>            // Datos con su etiqueta encima
39377>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Nacionalidad</div>' + BanderaHtml(sNac) + '</div>') to sHtml
39378>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Equipo</div>' + EquipoHtml(sEquipo) + '</div>') to sHtml
39379>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Liga</div>' + LigaHtml(sPais, sLiga) + '</div>') to sHtml
39380>>>            If (iEquipoID <> 0) Begin
39382>>>                Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Entrenador</div>' + EntrenadorHtml(iEquipoID) + '</div>') to sHtml
39383>>>            End
39383>>>>
39383>>>            Move (sHtml + '</div></div>') to sHtml
39384>>>
39384>>>            // Dorsal grande con las iniciales del club de fondo
39384>>>            Move (sHtml + '<div class="CromoDorsal">' + ;                  '<span class="CromoMarca">' + sMarca + '</span>' + ;                  '<span class="CromoNumero"><small>#</small>' + sID + '</span>' + ;                  '</div></div>') to sHtml
39385>>>        End
39385>>>>
39385>>>
39385>>>        Send UpdateHTML of oCabecera sHtml
39386>>>    End_Procedure
39387>>>
39387>>>    Procedure SetActionButtons
39390>>>        tWebNavigateData NavigateData
39390>>>        tWebNavigateData NavigateData
39390>>>        Boolean bHasRecord
39390>>>        Handle hoDD
39390>>>
39390>>>        Get Server to hoDD
39391>>>        Get GetNavigateData to NavigateData
39392>>>        Get HasRecord of hoDD to bHasRecord
39393>>>
39393>>>        // let's hide all buttons and then Show the ones we want
39393>>>        WebSet pbRender of oEditBtn to False
39394>>>        WebSet pbRender of oSaveBtn to False
39395>>>        WebSet pbRender of oCancelChangesBtn to False
39396>>>        WebSet pbRender of oDeleteBtn to False
39397>>>
39397>>>        // El boton "Ver posiciones" solo se muestra si hay un jugador cargado
39397>>>        WebSet pbRender of oVerPosicionesBtn to bHasRecord
39398>>>
39398>>>        If (NavigateData.bReadOnly) Begin
39400>>>            WebSet pbRender of oEditBtn to True
39401>>>        End
39401>>>>
39401>>>        Else Begin
39402>>>            WebSet pbRender of oSaveBtn to True
39403>>>            WebSet pbRender of oCancelChangesBtn to True
39404>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39405>>>        End
39405>>>>
39405>>>    End_Procedure
