37484>>>>>
37484>>>>>// ---------------------------------------------------------------
37484>>>>>// Codigo de bandera (flagcdn.com) a partir de una nacionalidad o pais.
37484>>>>>// Devuelve "" si no se reconoce.
37484>>>>>// ---------------------------------------------------------------
37484>>>>>Function CodigoBandera Global String sNac Returns String
37486>>>>>    String sTexto sCod
37486>>>>>
37486>>>>>    Move (Trim(sNac)) to sTexto
37487>>>>>    Move "" to sCod
37488>>>>>
37488>>>>>    Case Begin
37488>>>>>        Case (Left(sTexto, 4) = "Espa")
37490>>>>>            Move "es" to sCod
37491>>>>>            Case Break
37492>>>>>        Case (Left(sTexto, 4) = "Alem")
37495>>>>>            Move "de" to sCod
37496>>>>>            Case Break
37497>>>>>        Case (Left(sTexto, 4) = "Arge")
37500>>>>>            Move "ar" to sCod
37501>>>>>            Case Break
37502>>>>>        Case (Left(sTexto, 4) = "Neer")
37505>>>>>            Move "nl" to sCod
37506>>>>>            Case Break
37507>>>>>        Case (Left(sTexto, 4) = "Ital")
37510>>>>>            Move "it" to sCod
37511>>>>>            Case Break
37512>>>>>        Case (Left(sTexto, 4) = "Belg")
37515>>>>>            Move "be" to sCod
37516>>>>>            Case Break
37517>>>>>        Case (Left(sTexto, 4) = "Bras")
37520>>>>>            Move "br" to sCod
37521>>>>>            Case Break
37522>>>>>        Case (Left(sTexto, 4) = "Fran")
37525>>>>>            Move "fr" to sCod
37526>>>>>            Case Break
37527>>>>>        Case (Left(sTexto, 4) = "Urug")
37530>>>>>            Move "uy" to sCod
37531>>>>>            Case Break
37532>>>>>        Case (Left(sTexto, 4) = "Ingl")
37535>>>>>            Move "gb-eng" to sCod
37536>>>>>            Case Break
37537>>>>>        Case (Left(sTexto, 4) = "Esco")
37540>>>>>            Move "gb-sct" to sCod
37541>>>>>            Case Break
37542>>>>>        Case (Left(sTexto, 4) = "Pola")
37545>>>>>            Move "pl" to sCod
37546>>>>>            Case Break
37547>>>>>        Case (Left(sTexto, 4) = "Eslo")
37550>>>>>            Move "si" to sCod
37551>>>>>            Case Break
37552>>>>>        Case (Left(sTexto, 4) = "Moza")
37555>>>>>            Move "mz" to sCod
37556>>>>>            Case Break
37557>>>>>        Case (Left(sTexto, 4) = "Port")
37560>>>>>            Move "pt" to sCod
37561>>>>>            Case Break
37562>>>>>        Case (Left(sTexto, 4) = "Noru")
37565>>>>>            Move "no" to sCod
37566>>>>>            Case Break
37567>>>>>        Case (Left(sTexto, 1) = "H")
37570>>>>>            // Hungaro
37570>>>>>            Move "hu" to sCod
37571>>>>>            Case Break
37572>>>>>        Case (Left(sTexto, 4) = "Colo")
37575>>>>>            Move "co" to sCod
37576>>>>>            Case Break
37577>>>>>        Case (Left(sTexto, 4) = "Egip")
37580>>>>>            Move "eg" to sCod
37581>>>>>            Case Break
37582>>>>>    Case End
37582>>>>>
37582>>>>>    Function_Return sCod
37583>>>>>End_Function
37584>>>>>
37584>>>>>// ---------------------------------------------------------------
37584>>>>>// Bandera + texto (nacionalidades y paises).
37584>>>>>// Imagenes de banderas de flagcdn.com
37584>>>>>// ---------------------------------------------------------------
37584>>>>>Function BanderaHtml Global String sNac Returns String
37586>>>>>    String sTexto sCod
37586>>>>>
37586>>>>>    Move (Trim(sNac)) to sTexto
37587>>>>>    Move (CodigoBandera(sTexto)) to sCod
37588>>>>>
37588>>>>>    If (sCod = "") Begin
37590>>>>>        Function_Return (htmlEncode(sTexto))
37591>>>>>    End
37591>>>>>>
37591>>>>>
37591>>>>>    Function_Return ('<img class="Bandera" src="https://flagcdn.com/w40/' + sCod + '.png" alt=""> ' + htmlEncode(sTexto))
37592>>>>>End_Function
37593>>>>>
37593>>>>>// ---------------------------------------------------------------
37593>>>>>// Sprint 3: etiqueta de liga con la bandera de su pais.
37593>>>>>// Ejemplo: [bandera de Espana] LaLiga
37593>>>>>// ---------------------------------------------------------------
37593>>>>>Function LigaHtml Global String sPais String sLiga Returns String
37595>>>>>    String sCod sBandera
37595>>>>>
37595>>>>>    // Sin liga (por ejemplo, entrenador sin equipo)
37595>>>>>    If (Trim(sLiga) = "") Begin
37597>>>>>        Function_Return '<span class="SinEquipo">-</span>'
37598>>>>>    End
37598>>>>>>
37598>>>>>
37598>>>>>    Move (CodigoBandera(sPais)) to sCod
37599>>>>>    Move "" to sBandera
37600>>>>>
37600>>>>>    If (sCod <> "") Begin
37602>>>>>        Move ('<img class="Bandera" src="https://flagcdn.com/w40/' + sCod + '.png" alt="">') to sBandera
37603>>>>>    End
37603>>>>>>
37603>>>>>
37603>>>>>    Function_Return ('<span class="LigaChip">' + sBandera + htmlEncode(Trim(sLiga)) + '</span>')
37604>>>>>End_Function
