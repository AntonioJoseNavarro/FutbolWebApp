38910>>>        tWebNavigateData NavigateData
38910>>>        tWebNavigateData NavigateData
38910>>>        Boolean bHasRecord
38910>>>        Handle hoDD
38910>>>
38910>>>        Get Server to hoDD
38911>>>        Get GetNavigateData to NavigateData
38912>>>        Get HasRecord of hoDD to bHasRecord
38913>>>
38913>>>        // let's hide all buttons and then Show the ones we want
38913>>>        WebSet pbRender of oEditBtn to False
38914>>>        WebSet pbRender of oSaveBtn to False
38915>>>        WebSet pbRender of oCancelChangesBtn to False
38916>>>        WebSet pbRender of oDeleteBtn to False
38917>>>
38917>>>        If (NavigateData.bReadOnly) Begin
38919>>>            WebSet pbRender of oEditBtn to True
38920>>>        End
38920>>>>
38920>>>        Else Begin
38921>>>            WebSet pbRender of oSaveBtn to True
38922>>>            WebSet pbRender of oCancelChangesBtn to True
38923>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38924>>>        End
38924>>>>
38924>>>    End_Procedure
