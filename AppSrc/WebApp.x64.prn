38310>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38313>>>        WebSet pbRender of oNewButton to True
38314>>>        WebSet pbRender of oDetailButton to True
38315>>>
38315>>>        Case Begin
38315>>>            Case (NavigateData.eNavigateType = nfFromParent)
38317>>>                // If from parent, this is a constrained drill down
38317>>>                // If Row select does main-zoom we don't need this
38317>>>                WebSet pbRender of oDetailButton to False
38318>>>                Case Break
38319>>>
38319>>>            Case (NavigateData.eNavigateType = nfFromChild)
38322>>>                // If from child, this is a probably a parent lookup from a Zoom
38322>>>                Case Break
38323>>>
38323>>>            Case (NavigateData.eNavigateType = nfFromMain)
38326>>>                // If from main, this is a probably a main-file lookup from a Zoom
38326>>>                WebSet pbRender of oDetailButton to False
38327>>>                Case Break
38328>>>
38328>>>            Case Else // must be nfUndefined
38328>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38328>>>                // If Row select does main-zoom we don't need this
38328>>>                WebSet pbRender of oDetailButton to False
38329>>>
38329>>>        Case End
38329>>>
38329>>>    End_Procedure
