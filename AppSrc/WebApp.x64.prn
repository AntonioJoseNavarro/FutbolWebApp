39139>>>    // Sprint 3: construye el cromo de la cabecera con los datos actuales
39139>>>    // de los DDO (entrenador y, por el relate, su equipo y su liga).
39139>>>    // Estructura: franja del club | nombre + datos con etiquetas | icono de entrenador
39139>>>    Procedure ActualizarCabecera
39142>>>        String sNombre sApellido sNac sEquipo sLiga sPais sClase sHtml sMarca
39142>>>
39142>>>        Get Field_Current_Value of oentrenador_DD Field entrenador.Nombre       to sNombre
39143>>>        Get Field_Current_Value of oentrenador_DD Field entrenador.Apellido     to sApellido
39144>>>        Get Field_Current_Value of oentrenador_DD Field entrenador.Nacionalidad to sNac
39145>>>        Get File_Field_Current_Value of oentrenador_DD File_Field equipo.Nombre to sEquipo
39146>>>        Get File_Field_Current_Value of oentrenador_DD File_Field liga.Nombre   to sLiga
39147>>>        Get File_Field_Current_Value of oentrenador_DD File_Field liga.Pais     to sPais
39148>>>
39148>>>        // Entrenador nuevo (sin nombre todavia)
39148>>>        If ((Trim(sNombre) = "") and (Trim(sApellido) = "")) Begin
39150>>>            Move ('<div class="Cromo"><div class="CromoFranja otro"></div>' + ;                  '<div class="CromoInfo"><div class="CromoNombre">Nuevo entrenador</div>' + ;                  '<div class="CromoAviso">Rellena sus datos y elige su equipo</div></div></div>') to sHtml
39151>>>        End
39151>>>>
39151>>>        Else Begin
39152>>>            Move (ClaseEquipo(sEquipo)) to sClase
39153>>>
39153>>>            // Marca de agua: iniciales del club (o la inicial si no tiene colores)
39153>>>            Move "" to sMarca
39154>>>            If (Trim(sEquipo) <> "") Begin
39156>>>                If (sClase = "otro") Begin
39158>>>                    Move (Uppercase(Left(Trim(sEquipo), 1))) to sMarca
39159>>>                End
39159>>>>
39159>>>                Else Begin
39160>>>                    Move (Uppercase(sClase)) to sMarca
39161>>>                End
39161>>>>
39161>>>            End
39161>>>>
39161>>>
39161>>>            // Franja + nombre
39161>>>            Move ('<div class="Cromo"><div class="CromoFranja ' + sClase + '"></div>' + ;                  '<div class="CromoInfo">' + ;                  '<div class="CromoNombre">' + htmlEncode(Trim(sNombre) + " " + Trim(sApellido)) + '</div>' + ;                  '<div class="CromoDatos">') to sHtml
39162>>>
39162>>>            // Datos con su etiqueta encima
39162>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Nacionalidad</div>' + BanderaHtml(sNac) + '</div>') to sHtml
39163>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Equipo</div>' + EquipoHtml(sEquipo) + '</div>') to sHtml
39164>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Liga</div>' + LigaHtml(sPais, sLiga) + '</div>') to sHtml
39165>>>            Move (sHtml + '</div></div>') to sHtml
39166>>>
39166>>>            // Icono de entrenador grande con las iniciales del club de fondo
39166>>>            Move (sHtml + '<div class="CromoDorsal">' + ;                  '<span class="CromoMarca">' + sMarca + '</span>' + ;                  '<span class="CromoNumero CromoIcono">&#128203;</span>' + ;                  '</div></div>') to sHtml
39167>>>        End
39167>>>>
39167>>>
39167>>>        Send UpdateHTML of oCabecera sHtml
39168>>>    End_Procedure
39169>>>
39169>>>    Procedure SetActionButtons
39172>>>        tWebNavigateData NavigateData
39172>>>        tWebNavigateData NavigateData
39172>>>        Boolean bHasRecord
39172>>>        Handle hoDD
39172>>>
39172>>>        Get Server to hoDD
39173>>>        Get GetNavigateData to NavigateData
39174>>>        Get HasRecord of hoDD to bHasRecord
39175>>>
39175>>>        // let's hide all buttons and then Show the ones we want
39175>>>        WebSet pbRender of oEditBtn to False
39176>>>        WebSet pbRender of oSaveBtn to False
39177>>>        WebSet pbRender of oCancelChangesBtn to False
39178>>>        WebSet pbRender of oDeleteBtn to False
39179>>>
39179>>>        If (NavigateData.bReadOnly) Begin
39181>>>            WebSet pbRender of oEditBtn to True
39182>>>        End
39182>>>>
39182>>>        Else Begin
39183>>>            WebSet pbRender of oSaveBtn to True
39184>>>            WebSet pbRender of oCancelChangesBtn to True
39185>>>            WebSet pbRender of oDeleteBtn to bHasRecord
39186>>>        End
39186>>>>
39186>>>    End_Procedure
39187>>>
39187>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
39190>>>        // Close after save
39190>>>        Send NavigateClose Self
39191>>>    End_Procedure
39192>>>
