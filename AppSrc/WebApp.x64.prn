37697>>>>>// ---------------------------------------------------------------
37697>>>>>// Sprint 3: clase CSS con los colores de cada club.
37697>>>>>// La usan la insignia (EquipoHtml) y la franja (JugadorHtml).
37697>>>>>// Devuelve "otro" para equipos sin colores definidos.
37697>>>>>// ---------------------------------------------------------------
37697>>>>>Function ClaseEquipo Global String sEquipo Returns String
37699>>>>>    String sTexto sClase
37699>>>>>
37699>>>>>    Move (Trim(sEquipo)) to sTexto
37700>>>>>    Move "otro" to sClase
37701>>>>>
37701>>>>>    Case Begin
37701>>>>>        Case (Left(sTexto, 4) = "Real")
37703>>>>>            Move "rm" to sClase
37704>>>>>            Case Break
37705>>>>>        Case (Left(sTexto, 4) = "FC B")
37708>>>>>            Move "fcb" to sClase
37709>>>>>            Case Break
37710>>>>>        Case (Left(sTexto, 3) = "Atl")
37713>>>>>            Move "atm" to sClase
37714>>>>>            Case Break
37715>>>>>        Case (Left(sTexto, 4) = "Manc")
37718>>>>>            Move "mci" to sClase
37719>>>>>            Case Break
37720>>>>>        Case (Left(sTexto, 4) = "Live")
37723>>>>>            Move "liv" to sClase
37724>>>>>            Case Break
37725>>>>>        Case (Left(sTexto, 4) = "Arse")
37728>>>>>            Move "ars" to sClase
37729>>>>>            Case Break
37730>>>>>    Case End
37730>>>>>
37730>>>>>    Function_Return sClase
37731>>>>>End_Function
37732>>>>>
37732>>>>>// ---------------------------------------------------------------
37732>>>>>// Insignia del equipo (iniciales con los colores del club) + texto.
37732>>>>>// Distintivo propio, NO el escudo oficial.
37732>>>>>// ---------------------------------------------------------------
37732>>>>>Function EquipoHtml Global String sEquipo Returns String
37734>>>>>    String sTexto sIni sClase
37734>>>>>
37734>>>>>    Move (Trim(sEquipo)) to sTexto
37735>>>>>
37735>>>>>    // Sprint 3: sin equipo asignado (por ejemplo, un entrenador libre)
37735>>>>>    If (sTexto = "") Begin
37737>>>>>        Function_Return '<span class="SinEquipo">Sin equipo</span>'
37738>>>>>    End
37738>>>>>>
37738>>>>>
37738>>>>>    Move (ClaseEquipo(sTexto)) to sClase
37739>>>>>
37739>>>>>    // Las iniciales coinciden con la clase (rm -> RM, fcb -> FCB...)
37739>>>>>    // Equipo nuevo sin colores definidos: insignia gris con la inicial
37739>>>>>    If (sClase = "otro") Begin
37741>>>>>        Move (Uppercase(Left(sTexto, 1))) to sIni
37742>>>>>    End
37742>>>>>>
37742>>>>>    Else Begin
37743>>>>>        Move (Uppercase(sClase)) to sIni
37744>>>>>    End
37744>>>>>>
37744>>>>>
37744>>>>>    Function_Return ('<span class="Insignia ' + sClase + '">' + sIni + '</span> <span class="EquipoNombre">' + htmlEncode(sTexto) + '</span>')
37745>>>>>End_Function
37746>>>>>
37746>>>>>// ---------------------------------------------------------------
37746>>>>>// Sprint 3: nombre completo de una persona (jugador o entrenador)
37746>>>>>// con una franja vertical de los colores de su equipo delante.
37746>>>>>// ---------------------------------------------------------------
37746>>>>>Function JugadorHtml Global String sNombre String sApellido String sEquipo Returns String
37748>>>>>    String sClase sCompleto
37748>>>>>
37748>>>>>    Move (ClaseEquipo(sEquipo)) to sClase
37749>>>>>    Move (Trim(sNombre) + " " + Trim(sApellido)) to sCompleto
37750>>>>>
37750>>>>>    Function_Return ('<span class="Franja ' + sClase + '"></span>' + htmlEncode(sCompleto))
37751>>>>>End_Function
37752>>>>>
37752>>>>>// ---------------------------------------------------------------
37752>>>>>// Sprint 3: entrenador de un equipo.
37752>>>>>// entrenador es HIJO de equipo, asi que el relate de los DD no lo trae:
37752>>>>>// se busca directamente (solo lectura) por el Index 3 (uqEntrenadorEquipo),
37752>>>>>// que es unico por EquipoID.
37752>>>>>// ---------------------------------------------------------------
37752>>>>>Function EntrenadorHtml Global Integer iEquipoID Returns String
37754>>>>>    String sNombre
37754>>>>>
37754>>>>>    If (iEquipoID = 0) Begin
37756>>>>>        Function_Return '<span class="SinEquipo">-</span>'
37757>>>>>    End
37757>>>>>>
37757>>>>>
37757>>>>>    Clear entrenador
37758>>>>>    Move iEquipoID to entrenador.EquipoID
37759>>>>>    Find EQ entrenador by Index.3
37760>>>>>>
37760>>>>>
37760>>>>>    If (Found) Begin
37762>>>>>        Move (Trim(entrenador.Nombre) + " " + Trim(entrenador.Apellido)) to sNombre
37763>>>>>        Function_Return ('<span class="EntrenadorChip">&#128203; ' + htmlEncode(sNombre) + '</span>')
37764>>>>>    End
37764>>>>>>
37764>>>>>
37764>>>>>    Function_Return '<span class="SinEquipo">Sin entrenador</span>'
37765>>>>>End_Function
37766>>>>>
37766>>>>>// ---------------------------------------------------------------
37766>>>>>// Sprint 3: plazas ocupadas de una liga ("3 / 20") con barra de ocupacion.
37766>>>>>// La barra se pinta de rojo cuando la liga esta llena.
37766>>>>>// ---------------------------------------------------------------
37766>>>>>Function PlazasHtml Global Integer iEquipos Integer iMax Returns String
37768>>>>>    Integer iPorc
37768>>>>>    String sEquipos sMax sPorc sClase
37768>>>>>
37768>>>>>    // Porcentaje de ocupacion (0-100)
37768>>>>>    If (iMax > 0) Begin
37770>>>>>        Move (iEquipos * 100 / iMax) to iPorc
37771>>>>>    End
37771>>>>>>
37771>>>>>    Else Begin
37772>>>>>        Move 0 to iPorc
37773>>>>>    End
37773>>>>>>
37773>>>>>    If (iPorc > 100) Begin
37775>>>>>        Move 100 to iPorc
37776>>>>>    End
37776>>>>>>
37776>>>>>
37776>>>>>    // Liga llena: clase extra para pintar la barra de rojo
37776>>>>>    Move "" to sClase
37777>>>>>    If ((iMax > 0) and (iEquipos >= iMax)) Begin
37779>>>>>        Move " Llena" to sClase
37780>>>>>    End
37780>>>>>>
37780>>>>>
37780>>>>>    Move iEquipos to sEquipos
37781>>>>>    Move iMax     to sMax
37782>>>>>    Move iPorc    to sPorc
37783>>>>>
37783>>>>>    Function_Return ('<span class="Plazas' + sClase + '">' + ;                     '<span class="PlazasTexto">' + sEquipos + ' / ' + sMax + '</span>' + ;                     '<span class="PlazasBarra"><span class="PlazasRelleno" style="width:' + sPorc + '%"></span></span>' + ;                     '</span>')
37784>>>>>End_Function
