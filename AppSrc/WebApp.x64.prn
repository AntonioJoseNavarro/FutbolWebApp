37333>>>        Get StateHash of ghoWebApp to sPrevStateHash
37334>>>        Send ParseViewStateHash sPrevStateHash (&sView)
37335>>>        If (Lowercase(sView) <> Lowercase(psStateViewName(Self))) Begin
37337>>>            WebSet psPrevStateHash to sPrevStateHash
37338>>>        End
37338>>>>
37338>>>        
37338>>>    End_Procedure
