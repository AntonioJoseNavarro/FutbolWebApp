37832>>>    // Sprint 3: construye el cromo de la cabecera con los datos de la posicion.
37832>>>    // Estructura: franja azul | nombre + tipo | icono grande en un circulo
37832>>>    Procedure ActualizarCabecera
37835>>>        String sPos sTipo sHtml
37835>>>
37835>>>        Get Field_Current_Value of oposicion_DD Field posicion.Nombre to sPos
37836>>>        Move (Trim(sPos)) to sPos
37837>>>
37837>>>        // Posicion nueva (sin nombre todavia)
37837>>>        If (sPos = "") Begin
37839>>>            Move ('<div class="Cromo"><div class="CromoFranja otro"></div>' + ;                  '<div class="CromoInfo"><div class="CromoNombre">Nueva posici&oacute;n</div>' + ;                  '<div class="CromoAviso">Escribe el nombre de la posici&oacute;n</div></div></div>') to sHtml
37840>>>        End
37840>>>>
37840>>>        Else Begin
37841>>>            // Tipo: oficial (las 4 del terreno de juego) o personalizada
37841>>>            Move "Personalizada" to sTipo
37842>>>            If ((Left(sPos, 4) = "Port") or (Left(sPos, 4) = "Defe") or (Left(sPos, 4) = "Cent") or (Left(sPos, 4) = "Dela")) Begin
37844>>>                Move "Oficial" to sTipo
37845>>>            End
37845>>>>
37845>>>
37845>>>            Move ('<div class="Cromo"><div class="CromoFranja posicion"></div>' + ;                  '<div class="CromoInfo">' + ;                  '<div class="CromoNombre">' + htmlEncode(sPos) + '</div>' + ;                  '<div class="CromoDatos">' + ;                  '<div class="CromoDato"><div class="CromoEtiqueta">Tipo</div>' + sTipo + '</div>' + ;                  '</div></div>' + ;                  '<div class="CromoDorsal"><span class="CromoIconoPos">' + IconoPosicion(sPos) + '</span></div>' + ;                  '</div>') to sHtml
37846>>>        End
37846>>>>
37846>>>
37846>>>        Send UpdateHTML of oCabecera sHtml
37847>>>    End_Procedure
37848>>>
37848>>>    Procedure SetActionButtons
37851>>>        tWebNavigateData NavigateData
37851>>>        tWebNavigateData NavigateData
37851>>>        Boolean bHasRecord
37851>>>        Handle hoDD
37851>>>
37851>>>        Get Server to hoDD
37852>>>        Get GetNavigateData to NavigateData
37853>>>        Get HasRecord of hoDD to bHasRecord
37854>>>
37854>>>        // let's hide all buttons and then Show the ones we want
37854>>>        WebSet pbRender of oEditBtn to False
37855>>>        WebSet pbRender of oSaveBtn to False
37856>>>        WebSet pbRender of oCancelChangesBtn to False
37857>>>        WebSet pbRender of oDeleteBtn to False
37858>>>
37858>>>        If (NavigateData.bReadOnly) Begin
37860>>>            WebSet pbRender of oEditBtn to True
37861>>>        End
37861>>>>
37861>>>        Else Begin
37862>>>            WebSet pbRender of oSaveBtn to True
37863>>>            WebSet pbRender of oCancelChangesBtn to True
37864>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37865>>>        End
37865>>>>
37865>>>    End_Procedure
