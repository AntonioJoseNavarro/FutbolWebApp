37524>>>    Procedure SetActionButtons
37527>>>        tWebNavigateData NavigateData
37527>>>        tWebNavigateData NavigateData
37527>>>        Boolean bHasRecord
37527>>>        Handle hoDD
37527>>>
37527>>>        Get Server to hoDD
37528>>>        Get GetNavigateData to NavigateData
37529>>>        Get HasRecord of hoDD to bHasRecord
37530>>>
37530>>>        // let's hide all buttons and then Show the ones we want
37530>>>        WebSet pbRender of oEditBtn to False
37531>>>        WebSet pbRender of oSaveBtn to False
37532>>>        WebSet pbRender of oCancelChangesBtn to False
37533>>>        WebSet pbRender of oDeleteBtn to False
37534>>>
37534>>>        If (NavigateData.bReadOnly) Begin
37536>>>            WebSet pbRender of oEditBtn to True
37537>>>        End
37537>>>>
37537>>>        Else Begin
37538>>>            WebSet pbRender of oSaveBtn to True
37539>>>            WebSet pbRender of oCancelChangesBtn to True
37540>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37541>>>        End
37541>>>>
37541>>>    End_Procedure
