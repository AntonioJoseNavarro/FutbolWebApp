38527>>>    Procedure SetActionButtons
38530>>>        tWebNavigateData NavigateData
38530>>>        tWebNavigateData NavigateData
38530>>>        Boolean bHasRecord
38530>>>        Handle hoDD
38530>>>
38530>>>        Get Server to hoDD
38531>>>        Get GetNavigateData to NavigateData
38532>>>        Get HasRecord of hoDD to bHasRecord
38533>>>
38533>>>        // let's hide all buttons and then Show the ones we want
38533>>>        WebSet pbRender of oEditBtn to False
38534>>>        WebSet pbRender of oSaveBtn to False
38535>>>        WebSet pbRender of oCancelChangesBtn to False
38536>>>        WebSet pbRender of oDeleteBtn to False
38537>>>
38537>>>        If (NavigateData.bReadOnly) Begin
38539>>>            WebSet pbRender of oEditBtn to True
38540>>>        End
38540>>>>
38540>>>        Else Begin
38541>>>            WebSet pbRender of oSaveBtn to True
38542>>>            WebSet pbRender of oCancelChangesBtn to True
38543>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38544>>>        End
38544>>>>
38544>>>    End_Procedure
38545>>>
