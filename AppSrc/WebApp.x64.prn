38547>>>                // If from parent, this is a constrained drill down.
38547>>>                Case Break
38548>>>
38548>>>            Case (NavigateData.eNavigateType = nfFromChild)
38551>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38551>>>                Case Break
38552>>>
38552>>>            Case Else // must be nfUndefined
38552>>>
38552>>>        Case End
38552>>>
38552>>>        Send SetActionButtons
