37582>>>    Procedure SetActionButtons
37585>>>        tWebNavigateData NavigateData
37585>>>        tWebNavigateData NavigateData
37585>>>        Boolean bHasRecord
37585>>>        Handle hoDD
37585>>>
37585>>>        Get Server to hoDD
37586>>>        Get GetNavigateData to NavigateData
37587>>>        Get HasRecord of hoDD to bHasRecord
37588>>>
37588>>>        // let's hide all buttons and then Show the ones we want
37588>>>        WebSet pbRender of oEditBtn to False
37589>>>        WebSet pbRender of oSaveBtn to False
37590>>>        WebSet pbRender of oCancelChangesBtn to False
37591>>>        WebSet pbRender of oDeleteBtn to False
37592>>>
37592>>>        If (NavigateData.bReadOnly) Begin
37594>>>            WebSet pbRender of oEditBtn to True
37595>>>        End
37595>>>>
37595>>>        Else Begin
37596>>>            WebSet pbRender of oSaveBtn to True
37597>>>            WebSet pbRender of oCancelChangesBtn to True
37598>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37599>>>        End
