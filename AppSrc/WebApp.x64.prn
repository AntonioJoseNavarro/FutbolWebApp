38069>>>    Procedure SetActionButtons
38072>>>        tWebNavigateData NavigateData
38072>>>        tWebNavigateData NavigateData
38072>>>        Boolean bHasRecord
38072>>>        Handle hoDD
38072>>>
38072>>>        Get Server to hoDD
38073>>>        Get GetNavigateData to NavigateData
38074>>>        Get HasRecord of hoDD to bHasRecord
38075>>>
38075>>>        // let's hide all buttons and then Show the ones we want
38075>>>        WebSet pbRender of oEditBtn to False
38076>>>        WebSet pbRender of oSaveBtn to False
38077>>>        WebSet pbRender of oCancelChangesBtn to False
38078>>>        WebSet pbRender of oDeleteBtn to False
38079>>>
38079>>>        If (NavigateData.bReadOnly) Begin
38081>>>            WebSet pbRender of oEditBtn to True
38082>>>        End
38082>>>>
38082>>>        Else Begin
38083>>>            WebSet pbRender of oSaveBtn to True
38084>>>            WebSet pbRender of oCancelChangesBtn to True
38085>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38086>>>        End
38086>>>>
38086>>>    End_Procedure
38087>>>
38087>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38090>>>        // Close after save
38090>>>        Send NavigateClose Self
38091>>>    End_Procedure
38092>>>
38092>>>    // this will close the view after a delete
38092>>>    Procedure OnViewDeleted Handle hoDDO
38095>>>        Send NavigateClose Self
38096>>>    End_Procedure
