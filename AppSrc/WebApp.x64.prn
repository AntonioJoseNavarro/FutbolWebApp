39526>>>
39526>>>    // Sprint 3: construye el cromo de la cabecera con los datos actuales
39526>>>    // de los DDO (jugador y, por el relate, su equipo y su liga).
39526>>>    // Estructura: franja del club | nombre + datos con etiquetas | dorsal
39526>>>    Procedure ActualizarCabecera
39529>>>        String sNombre sApellido sNac sEquipo sLiga sPais sClase sHtml sID sMarca
39529>>>        Integer iID iEquipoID
39529>>>
39529>>>        Get Field_Current_Value of ojugador_DD Field jugador.ID           to iID
39530>>>        Get Field_Current_Value of ojugador_DD Field jugador.Nombre       to sNombre
39531>>>        Get Field_Current_Value of ojugador_DD Field jugador.Apellido     to sApellido
39532>>>        Get Field_Current_Value of ojugador_DD Field jugador.Nacionalidad to sNac
39533>>>        Get File_Field_Current_Value of ojugador_DD File_Field equipo.ID     to iEquipoID
39534>>>        Get File_Field_Current_Value of ojugador_DD File_Field equipo.Nombre to sEquipo
39535>>>        Get File_Field_Current_Value of ojugador_DD File_Field liga.Nombre   to sLiga
39536>>>        Get File_Field_Current_Value of ojugador_DD File_Field liga.Pais     to sPais
39537>>>
39537>>>        // Jugador nuevo (sin nombre todavia)
39537>>>        If ((Trim(sNombre) = "") and (Trim(sApellido) = "")) Begin
39539>>>            Move ('<div class="Cromo"><div class="CromoFranja otro"></div>' + ;                  '<div class="CromoInfo"><div class="CromoNombre">Nuevo jugador</div>' + ;                  '<div class="CromoAviso">Rellena sus datos y elige su equipo</div></div></div>') to sHtml
39540>>>        End
39540>>>>
39540>>>        Else Begin
39541>>>            Move (ClaseEquipo(sEquipo)) to sClase
39542>>>
39542>>>            // Marca de agua: iniciales del club (o la inicial si no tiene colores)
39542>>>            Move "" to sMarca
39543>>>            If (Trim(sEquipo) <> "") Begin
39545>>>                If (sClase = "otro") Begin
39547>>>                    Move (Uppercase(Left(Trim(sEquipo), 1))) to sMarca
39548>>>                End
39548>>>>
39548>>>                Else Begin
39549>>>                    Move (Uppercase(sClase)) to sMarca
39550>>>                End
39550>>>>
39550>>>            End
39550>>>>
39550>>>
39550>>>            Move iID to sID
39551>>>
39551>>>            // Franja + nombre
39551>>>            Move ('<div class="Cromo"><div class="CromoFranja ' + sClase + '"></div>' + ;                  '<div class="CromoInfo">' + ;                  '<div class="CromoNombre">' + htmlEncode(Trim(sNombre) + " " + Trim(sApellido)) + '</div>' + ;                  '<div class="CromoDatos">') to sHtml
39552>>>
39552>>>            // Datos con su etiqueta encima
39552>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Nacionalidad</div>' + BanderaHtml(sNac) + '</div>') to sHtml
39553>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Equipo</div>' + EquipoHtml(sEquipo) + '</div>') to sHtml
39554>>>            Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Liga</div>' + LigaHtml(sPais, sLiga) + '</div>') to sHtml
39555>>>            If (iEquipoID <> 0) Begin
39557>>>                Move (sHtml + '<div class="CromoDato"><div class="CromoEtiqueta">Entrenador</div>' + EntrenadorHtml(iEquipoID) + '</div>') to sHtml
39558>>>            End
39558>>>>
39558>>>            Move (sHtml + '</div></div>') to sHtml
39559>>>
39559>>>            // Dorsal grande con las iniciales del club de fondo
39559>>>            Move (sHtml + '<div class="CromoDorsal">' + ;                  '<span class="CromoMarca">' + sMarca + '</span>' + ;                  '<span class="CromoNumero"><small>#</small>' + sID + '</span>' + ;                  '</div></div>') to sHtml
39560>>>        End
39560>>>>
39560>>>
39560>>>        Send UpdateHTML of oCabecera sHtml
39561>>>    End_Procedure
39562>>>
